---
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import DocsLayout       from "@/layouts/DocsLayout.astro";
import ComponentPreview from "@/components/docs/ComponentPreview.astro";
import {
  AuthCardBlock, StatsRowBlock, EmptyStateBlock, PricingSectionBlock, SettingsPanelBlock,
  PageHeaderBlock, ConfirmDialogBlock, ItemListBlock, DataTablePageBlock, FormPageBlock,
  AppShellBlock,
} from "@/components/demos/BlocksDemo";

// Read the actual block source (React + Vue) so the docs always match the
// single source of truth in @usevyre/ai-context — no hand-typed drift, and the
// Vue tab shows the real Vue code.
const BLOCKS_DIR = resolve(process.cwd(), "../../packages/ai-context/src/blocks");

function blockCode(file: string): { react: string; vue: string } {
  const md = readFileSync(resolve(BLOCKS_DIR, file), "utf8");
  const react = md.match(/## React\s+```tsx\n([\s\S]*?)```/)?.[1]?.trim() ?? "";
  const vue = md.match(/## Vue\s+```vue\n([\s\S]*?)```/)?.[1]?.trim() ?? "";
  return { react, vue };
}

const auth     = blockCode("auth-card.md");
const stats    = blockCode("stats-row.md");
const empty    = blockCode("empty-state.md");
const pricing  = blockCode("pricing-section.md");
const settings = blockCode("settings-panel.md");
const pageHeader = blockCode("page-header.md");
const confirm    = blockCode("confirm-dialog.md");
const itemList   = blockCode("item-list.md");
const dataTable  = blockCode("data-table-page.md");
const formPage   = blockCode("form-page.md");
const appShell   = blockCode("app-shell.md");
---

<DocsLayout title="Blocks">
  <div class="docs-header">
    <h1 class="docs-title">Blocks</h1>
    <p class="docs-lead">
      Ready-made compositions of useVyre components for whole sections — copy,
      paste, and adapt. They are a starting point, not fixed components. Your AI
      agent knows these patterns too: they're part of the
      <a href="/docs/ai-context">AI context</a>, so it composes pages correctly.
    </p>
  </div>

  <hr class="docs-divider" />

  <h2 class="docs-h2">Auth card</h2>
  <p class="docs-p">A centered sign-in card. For a login or sign-in screen.</p>
  <ComponentPreview react={auth.react} vue={auth.vue}>
    <AuthCardBlock client:visible />
  </ComponentPreview>

  <h2 class="docs-h2">Stats row</h2>
  <p class="docs-p">Headline KPIs for the top of a dashboard.</p>
  <ComponentPreview react={stats.react} vue={stats.vue}>
    <StatsRowBlock client:visible />
  </ComponentPreview>

  <h2 class="docs-h2">Empty state</h2>
  <p class="docs-p">A friendly zero-data screen with a call to action.</p>
  <ComponentPreview react={empty.react} vue={empty.vue}>
    <EmptyStateBlock client:visible />
  </ComponentPreview>

  <h2 class="docs-h2">Pricing section</h2>
  <p class="docs-p">A three-tier pricing grid with a highlighted plan.</p>
  <ComponentPreview react={pricing.react} vue={pricing.vue}>
    <PricingSectionBlock client:visible />
  </ComponentPreview>

  <h2 class="docs-h2">Settings panel</h2>
  <p class="docs-p">An account / preferences panel with fields and toggles.</p>
  <ComponentPreview react={settings.react} vue={settings.vue}>
    <SettingsPanelBlock client:visible />
  </ComponentPreview>

  <h2 class="docs-h2">App shell</h2>
  <p class="docs-p">The application frame — collapsible sidebar nav + an app bar over the content.</p>
  <ComponentPreview react={appShell.react} vue={appShell.vue}>
    <AppShellBlock client:visible />
  </ComponentPreview>

  <h2 class="docs-h2">Page header</h2>
  <p class="docs-p">A title row with breadcrumb and primary actions — the top of most pages.</p>
  <ComponentPreview react={pageHeader.react} vue={pageHeader.vue}>
    <PageHeaderBlock client:visible />
  </ComponentPreview>

  <h2 class="docs-h2">Data table page</h2>
  <p class="docs-p">Heading, search toolbar, table and pagination — the common list/CRUD screen.</p>
  <ComponentPreview react={dataTable.react} vue={dataTable.vue}>
    <DataTablePageBlock client:visible />
  </ComponentPreview>

  <h2 class="docs-h2">Form page</h2>
  <p class="docs-p">A validated create/edit form in a card with submit and cancel actions.</p>
  <ComponentPreview react={formPage.react} vue={formPage.vue}>
    <FormPageBlock client:visible />
  </ComponentPreview>

  <h2 class="docs-h2">Item list</h2>
  <p class="docs-p">A list of rows with media, title/description and a trailing action.</p>
  <ComponentPreview react={itemList.react} vue={itemList.vue}>
    <ItemListBlock client:visible />
  </ComponentPreview>

  <h2 class="docs-h2">Confirm dialog</h2>
  <p class="docs-p">A destructive-action confirmation modal. Click to open.</p>
  <ComponentPreview react={confirm.react} vue={confirm.vue}>
    <ConfirmDialogBlock client:visible />
  </ComponentPreview>
</DocsLayout>
