---
import DocsLayout       from "@/layouts/DocsLayout.astro";
import ComponentPreview from "@/components/docs/ComponentPreview.astro";
import PropsTable       from "@/components/docs/PropsTable.astro";
import AICheatSheet from "@/components/docs/AICheatSheet.astro";
import {
  CalendarSingleDemo,
  CalendarRangeDemo,
  CalendarTimeDemo,
  DatePickerDemo,
} from "@/components/demos/Tier2Demo";

const codeSingleReact = `import { Calendar } from "@usevyre/react";

const [date, setDate] = useState<Date | null>(null);

<Calendar mode="single" value={date} onChange={setDate} />`;

const codeSingleVue = `<script setup>
import { Calendar } from "@usevyre/vue";
const date = ref(null);
</script>
<template>
  <Calendar mode="single" v-model="date" />
</template>`;

const codeRangeReact = `import { Calendar } from "@usevyre/react";

const [range, setRange] = useState<[Date | null, Date | null]>([null, null]);

<Calendar mode="range" value={range} onChange={setRange} />`;

const codeRangeVue = `<script setup>
import { Calendar } from "@usevyre/vue";
const range = ref([null, null]);
</script>
<template>
  <Calendar mode="range" v-model="range" />
</template>`;

const codeTimeReact = `import { Calendar } from "@usevyre/react";

const [date, setDate] = useState<Date | null>(null);

<Calendar mode="single" showTime value={date} onChange={setDate} />`;

const codeTimeVue = `<script setup>
import { Calendar } from "@usevyre/vue";
const date = ref(null);
</script>
<template>
  <Calendar mode="single" :show-time="true" v-model="date" />
</template>`;

const codeDatePickerReact = `import { DatePicker } from "@usevyre/react";

const [date, setDate] = useState<Date | null>(null);
const [range, setRange] = useState<[Date | null, Date | null]>([null, null]);

// Single
<DatePicker mode="single" value={date} onChange={setDate} placeholder="Pick a date" />

// Range
<DatePicker mode="range" value={range} onChange={setRange} placeholder="Pick a range" />`;

const codeDatePickerVue = `<script setup>
import { DatePicker } from "@usevyre/vue";
const date = ref(null);
const range = ref([null, null]);
</script>
<template>
  <!-- Single -->
  <DatePicker mode="single" v-model="date" placeholder="Pick a date" />

  <!-- Range -->
  <DatePicker mode="range" v-model="range" placeholder="Pick a range" />
</template>`;

const calendarProps = [
  { name: "mode",           type: '"single" | "range" | "multiple"',    default: '"single"',  description: "Selection mode. single picks one date, range picks start–end, multiple picks any number of dates." },
  { name: "value / v-model", type: "Date | [Date|null, Date|null] | Date[]", default: "—",    description: "Controlled selected value. Type depends on mode." },
  { name: "onChange / @update:modelValue", type: "(v) => void",         default: "—",         description: "Called when the selection changes." },
  { name: "showTime",       type: "boolean",                             default: "false",     description: "Adds an HH:MM time picker below the calendar grid." },
  { name: "minDate",        type: "Date",                                default: "—",         description: "Dates before this are disabled." },
  { name: "maxDate",        type: "Date",                                default: "—",         description: "Dates after this are disabled." },
  { name: "disabled",       type: "(date: Date) => boolean",             default: "—",         description: "Custom callback to disable specific dates." },
  { name: "weekStartsOn",   type: "0 | 1",                              default: "1",         description: "First day of the week. 0 = Sunday, 1 = Monday." },
  { name: "class / className", type: "string",                          default: "—",         description: "Additional CSS class on the root element." },
];

const datePickerProps = [
  { name: "+ Calendar props", type: "—",                               default: "—",          description: "All Calendar props are forwarded." },
  { name: "placeholder",    type: "string",                             default: '"Pick a date"', description: "Placeholder text shown when no date is selected." },
  { name: "inputClass / inputClassName", type: "string",               default: "—",          description: "Additional CSS class on the trigger button." },
];
---

<DocsLayout title="Calendar" component="Calendar">
  <div class="docs-header">
    <div class="docs-header__meta">
      <span class="vyre-badge vyre-badge--default">@usevyre/react</span>
      <span class="vyre-badge vyre-badge--default">@usevyre/vue</span>
    </div>
    <h1 class="docs-title">Calendar</h1>
    <p class="docs-lead">
      A flexible date picker supporting single date, date range, and multiple date selection.
      Use <code>Calendar</code> for an always-visible grid or <code>DatePicker</code> for
      an input-triggered popover. Includes month/year navigation, time picker, and
      min/max/disabled constraints. Zero dependencies — built on native <code>Intl</code> APIs.
    </p>
  </div>

  <hr class="docs-divider" />

  <h2 class="docs-h2">Single date</h2>
  <p class="docs-p">
    Default mode. Click any day to select it. Click again to deselect.
  </p>
  <ComponentPreview react={codeSingleReact} vue={codeSingleVue}>
    <CalendarSingleDemo client:visible />
  </ComponentPreview>

  <h2 class="docs-h2">Date range</h2>
  <p class="docs-p">
    Set <code>mode="range"</code>. First click sets the start date, second click sets the end.
    Hover previews the range before confirming.
  </p>
  <ComponentPreview react={codeRangeReact} vue={codeRangeVue}>
    <CalendarRangeDemo client:visible />
  </ComponentPreview>

  <h2 class="docs-h2">With time picker</h2>
  <p class="docs-p">
    Add <code>showTime</code> to include an HH:MM input below the grid.
    The time is stored in the same <code>Date</code> object.
  </p>
  <ComponentPreview react={codeTimeReact} vue={codeTimeVue}>
    <CalendarTimeDemo client:visible />
  </ComponentPreview>

  <h2 class="docs-h2">DatePicker — input + popover</h2>
  <p class="docs-p">
    <code>DatePicker</code> wraps <code>Calendar</code> in a trigger button that opens a popover.
    All Calendar props are forwarded. The popover closes automatically after selection
    (or when both range dates are picked).
  </p>
  <ComponentPreview react={codeDatePickerReact} vue={codeDatePickerVue}>
    <DatePickerDemo client:visible />
  </ComponentPreview>

  <h2 class="docs-h2">Props — Calendar</h2>
  <PropsTable props={calendarProps} />

  <h2 class="docs-h2">Props — DatePicker</h2>
  <PropsTable props={datePickerProps} />

  <AICheatSheet component="Calendar" />

  <div class="docs-pagination">
    <a href="/docs/components/command" class="docs-pagination__link docs-pagination__link--prev">
      ← Command
    </a>
  </div>
</DocsLayout>
