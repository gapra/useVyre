---
import DocsLayout          from "@/layouts/DocsLayout.astro";
import ComponentPreview    from "@/components/docs/ComponentPreview.astro";
import PropsTable          from "@/components/docs/PropsTable.astro";
import AICheatSheet        from "@/components/docs/AICheatSheet.astro";
import { ToggleGroupDemo } from "@/components/demos/ToggleGroupDemo";

const codeReact = `import { useState } from "react";
import { ToggleGroup, ToggleItem, Stack, Text } from "@usevyre/react";

const [view, setView] = useState<string | null>("grid");
const [fmt, setFmt] = useState<string[]>(["bold"]);

<Stack direction="column" gap="lg">
  <Stack direction="column" gap="xs">
    <Text size="sm" color="muted">Single — view ({view ?? "none"})</Text>
    <ToggleGroup
      value={view}
      onChange={setView}
      options={[
        { value: "grid", label: "Grid" },
        { value: "list", label: "List" },
        { value: "board", label: "Board" },
      ]}
    />
  </Stack>
  <Stack direction="column" gap="xs">
    <Text size="sm" color="muted">Multiple — format ({fmt.join(", ") || "none"})</Text>
    <ToggleGroup type="multiple" value={fmt} onChange={setFmt}>
      <ToggleItem value="bold">B</ToggleItem>
      <ToggleItem value="italic">I</ToggleItem>
      <ToggleItem value="underline">U</ToggleItem>
    </ToggleGroup>
  </Stack>
</Stack>`;

const codeVue = `<script setup>
import { ref } from "vue";
import { ToggleGroup, ToggleItem, Stack, Text } from "@usevyre/vue";

const view = ref("grid");
const fmt = ref(["bold"]);
</script>
<template>
  <Stack direction="column" gap="lg">
    <Stack direction="column" gap="xs">
      <Text size="sm" color="muted">Single — view ({{ view ?? "none" }})</Text>
      <ToggleGroup
        v-model="view"
        :options="[
          { value: 'grid', label: 'Grid' },
          { value: 'list', label: 'List' },
          { value: 'board', label: 'Board' },
        ]"
      />
    </Stack>
    <Stack direction="column" gap="xs">
      <Text size="sm" color="muted">Multiple — format ({{ fmt.join(', ') || 'none' }})</Text>
      <ToggleGroup type="multiple" v-model="fmt">
        <ToggleItem value="bold">B</ToggleItem>
        <ToggleItem value="italic">I</ToggleItem>
        <ToggleItem value="underline">U</ToggleItem>
      </ToggleGroup>
    </Stack>
  </Stack>
</template>`;

const props = [
  { name: "type",        type: `"single" | "multiple"`, default: `"single"`, description: "single → value string|null; multiple → value string[]." },
  { name: "value",       type: "string | null | string[]", default: "—", description: "Controlled selected value (shape depends on type)." },
  { name: "onChange",    type: "(value) => void", default: "—", description: "Emits the value — string|null or string[]. Not an event." },
  { name: "options",     type: "{ value; label?; icon?; disabled? }[]", default: "—", description: "Alternative to ToggleItem children for simple lists." },
  { name: "size",        type: `"sm" | "md" | "lg"`, default: `"md"`, description: "Control size." },
  { name: "orientation", type: `"horizontal" | "vertical"`, default: `"horizontal"`, description: "Layout direction." },
  { name: "disabled",    type: "boolean", default: "false", description: "Disable the whole group." },
];

const itemProps = [
  { name: "value",    type: "string",    default: "—", description: "This item's value (required)." },
  { name: "icon",     type: "ReactNode", default: "—", description: "Optional leading icon." },
  { name: "disabled", type: "boolean",   default: "false", description: "Disable just this item." },
];
---

<DocsLayout title="Toggle Group" component="ToggleGroup">
  <div class="docs-header">
    <div class="docs-header__meta">
      <span class="vyre-badge vyre-badge--default">@usevyre/react</span>
      <span class="vyre-badge vyre-badge--default">@usevyre/vue</span>
    </div>
    <h1 class="docs-title">Toggle Group</h1>
    <p class="docs-lead">
      A segmented control for choosing one or many options. Controlled —
      <code>onChange</code> emits the value, not an event. Use
      <code>type="single"</code> (string) or <code>type="multiple"</code>
      (array). Not a <a href="/docs/components/switch">Switch</a> (boolean) or
      <a href="/docs/components/button-group">ButtonGroup</a> (layout only).
    </p>
  </div>

  <hr class="docs-divider" />

  <h2 class="docs-h2">Single & multiple</h2>
  <p class="docs-p">
    The first group is single-select via <code>options</code>; the second is
    multi-select with composable <code>ToggleItem</code> children. Arrow keys
    move focus between items.
  </p>
  <ComponentPreview react={codeReact} vue={codeVue}>
    <ToggleGroupDemo client:visible />
  </ComponentPreview>

  <h2 class="docs-h2">Props</h2>
  <PropsTable props={props} />

  <h2 class="docs-h2">ToggleItem props</h2>
  <p class="docs-p">
    Use <code>ToggleItem</code> children for custom content (icons, mixed
    markup). For plain lists, prefer <code>options</code>.
  </p>
  <PropsTable props={itemProps} />

  <AICheatSheet component="ToggleGroup" />

  <div class="docs-pagination">
    <a href="/docs/components/toast" class="docs-pagination__link docs-pagination__link--prev">
      ← Toast
    </a>
    <a href="/docs/components/tooltip" class="docs-pagination__link docs-pagination__link--next">
      Tooltip →
    </a>
  </div>
</DocsLayout>
