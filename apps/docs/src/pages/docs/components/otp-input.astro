---
import DocsLayout         from "@/layouts/DocsLayout.astro";
import ComponentPreview   from "@/components/docs/ComponentPreview.astro";
import PropsTable         from "@/components/docs/PropsTable.astro";
import AICheatSheet       from "@/components/docs/AICheatSheet.astro";
import { OTPInputDemo, OTPInputMaskedDemo } from "@/components/demos/OTPInputDemo";

const codeReact = `import { useState } from "react";
import { OTPInput } from "@usevyre/react";

const [code, setCode] = useState("");

<OTPInput
  value={code}
  onChange={setCode}
  onComplete={(c) => verify(c)}
  autoFocus
/>`;

const codeVue = `<script setup>
import { ref } from "vue";
import { OTPInput } from "@usevyre/vue";

const code = ref("");

function verify(c) { /* ... */ }
</script>
<template>
  <OTPInput
    v-model="code"
    @complete="verify"
    autofocus
  />
</template>`;

const codeMaskReact = `import { useState } from "react";
import { OTPInput } from "@usevyre/react";

const [pin, setPin] = useState("");

<OTPInput value={pin} onChange={setPin} length={4} mask size="lg" />`;

const codeMaskVue = `<script setup>
import { ref } from "vue";
import { OTPInput } from "@usevyre/vue";

const pin = ref("");
</script>
<template>
  <OTPInput v-model="pin" :length="4" mask size="lg" />
</template>`;

const props = [
  { name: "value",        type: "string", default: "—", description: "Controlled value. Omit for uncontrolled." },
  { name: "defaultValue", type: "string", default: '""', description: "Initial value when uncontrolled." },
  { name: "onChange",     type: "(value: string) => void", default: "—", description: "Emits the combined code string. NOT an event." },
  { name: "onComplete",   type: "(value: string) => void", default: "—", description: "Fires once when every slot is filled." },
  { name: "length",       type: "number", default: "6", description: "Number of slots." },
  { name: "type",         type: `"numeric" | "alphanumeric"`, default: `"numeric"`, description: "Accepted characters." },
  { name: "mask",         type: "boolean", default: "false", description: "Render dots instead of characters." },
  { name: "size",         type: `"sm" | "md" | "lg"`, default: `"md"`, description: "Slot size." },
  { name: "disabled",     type: "boolean", default: "false", description: "Disable all slots." },
  { name: "autoFocus",    type: "boolean", default: "false", description: "Focus the first slot on mount (Vue: autofocus)." },
];
---

<DocsLayout title="OTP Input" component="OTPInput">
  <div class="docs-header">
    <div class="docs-header__meta">
      <span class="vyre-badge vyre-badge--default">@usevyre/react</span>
      <span class="vyre-badge vyre-badge--default">@usevyre/vue</span>
    </div>
    <h1 class="docs-title">OTP Input</h1>
    <p class="docs-lead">
      A segmented one-time-code input for verification and 2FA. Controlled —
      <code>onChange</code> emits the code <strong>string</strong> (never an
      event), and <code>onComplete</code> fires when it’s full. Paste a whole
      code and every slot fills; typing auto-advances, backspace steps back.
      Drops straight into <a href="/docs/components/form">Form</a>.
    </p>
  </div>

  <hr class="docs-divider" />

  <h2 class="docs-h2">6-digit code</h2>
  <p class="docs-p">
    Type or paste. <code>onComplete</code> fires once all six slots are
    filled — wire it to your verify call.
  </p>
  <ComponentPreview react={codeReact} vue={codeVue}>
    <OTPInputDemo client:visible />
  </ComponentPreview>

  <h2 class="docs-h2">Masked PIN</h2>
  <p class="docs-p">
    <code>mask</code> renders dots (like a password); combine with
    <code>length</code> and <code>size</code> for a short PIN.
  </p>
  <ComponentPreview react={codeMaskReact} vue={codeMaskVue}>
    <OTPInputMaskedDemo client:visible />
  </ComponentPreview>

  <h2 class="docs-h2">Props</h2>
  <PropsTable props={props} />

  <div class="docs-callout docs-callout--accent">
    <strong>Emits a string, not an event.</strong> Like the other useVyre
    inputs, <code>onChange</code> gives you the value directly — so it works in
    <code>FormField</code> with no glue.
  </div>

  <AICheatSheet component="OTPInput" />

  <div class="docs-pagination">
    <a href="/docs/components/number-input" class="docs-pagination__link docs-pagination__link--prev">
      ← Number Input
    </a>
    <a href="/docs/components/pagination" class="docs-pagination__link docs-pagination__link--next">
      Pagination →
    </a>
  </div>
</DocsLayout>
