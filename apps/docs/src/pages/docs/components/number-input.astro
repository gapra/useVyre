---
import DocsLayout         from "@/layouts/DocsLayout.astro";
import ComponentPreview   from "@/components/docs/ComponentPreview.astro";
import PropsTable         from "@/components/docs/PropsTable.astro";
import AICheatSheet       from "@/components/docs/AICheatSheet.astro";
import { NumberInputDemo } from "@/components/demos/NumberInputDemo";

const codeReact = `import { useState } from "react";
import { NumberInput, Stack, Text } from "@usevyre/react";

const [qty, setQty] = useState<number | null>(1);
const [price, setPrice] = useState<number | null>(9.99);

<Stack direction="column" gap="lg">
  <Stack direction="column" gap="xs">
    <Text size="sm" color="muted">Quantity (1–99, step 1)</Text>
    <NumberInput value={qty} onChange={setQty} min={1} max={99} />
  </Stack>
  <Stack direction="column" gap="xs">
    <Text size="sm" color="muted">Price (step 0.5, 2 decimals)</Text>
    <NumberInput
      value={price}
      onChange={setPrice}
      min={0}
      step={0.5}
      precision={2}
    />
  </Stack>
</Stack>`;

const codeVue = `<script setup>
import { ref } from "vue";
import { NumberInput, Stack, Text } from "@usevyre/vue";

const qty = ref(1);
const price = ref(9.99);
</script>
<template>
  <Stack direction="column" gap="lg">
    <Stack direction="column" gap="xs">
      <Text size="sm" color="muted">Quantity (1–99, step 1)</Text>
      <NumberInput v-model="qty" :min="1" :max="99" />
    </Stack>
    <Stack direction="column" gap="xs">
      <Text size="sm" color="muted">Price (step 0.5, 2 decimals)</Text>
      <NumberInput v-model="price" :min="0" :step="0.5" :precision="2" />
    </Stack>
  </Stack>
</template>`;

const codeForm = `import { Form, FormField, NumberInput, Button } from "@usevyre/react";

<Form onSubmit={(v) => save(v)}>
  <FormField name="age" label="Age" rules={{ required: true, min: 18 }}>
    <NumberInput min={0} max={120} />
  </FormField>
  <Button type="submit" variant="primary">Continue</Button>
</Form>`;

const props = [
  { name: "value",        type: "number | null", default: "—", description: "Controlled value. null = empty. Omit for uncontrolled." },
  { name: "defaultValue", type: "number | null", default: "null", description: "Initial value when uncontrolled." },
  { name: "onChange",     type: "(value: number | null) => void", default: "—", description: "Emits the parsed number, or null when empty. NOT an event." },
  { name: "min",          type: "number", default: "—", description: "Minimum; clamped on blur." },
  { name: "max",          type: "number", default: "—", description: "Maximum; clamped on blur." },
  { name: "step",         type: "number", default: "1", description: "Increment/decrement amount." },
  { name: "precision",    type: "number", default: "—", description: "Decimal places to round to." },
  { name: "size",         type: `"sm" | "md" | "lg"`, default: `"md"`, description: "Control size." },
  { name: "disabled",     type: "boolean", default: "false", description: "Disable input and steppers." },
  { name: "readOnly",     type: "boolean", default: "false", description: "Read-only (no stepping/typing)." },
];
---

<DocsLayout title="Number Input" component="NumberInput">
  <div class="docs-header">
    <div class="docs-header__meta">
      <span class="vyre-badge vyre-badge--default">@usevyre/react</span>
      <span class="vyre-badge vyre-badge--default">@usevyre/vue</span>
    </div>
    <h1 class="docs-title">Number Input</h1>
    <p class="docs-lead">
      A controlled numeric input with −/+ stepper buttons. It emits a real
      <strong>number</strong> (or <code>null</code> when empty) — never a
      string or an event — so it drops straight into
      <a href="/docs/components/form">Form</a> without parsing.
    </p>
  </div>

  <hr class="docs-divider" />

  <h2 class="docs-h2">Stepper, min/max & precision</h2>
  <p class="docs-p">
    Use the buttons or type directly. <kbd>↑</kbd>/<kbd>↓</kbd> step by
    <code>step</code>; hold <kbd>Shift</kbd> for ×10. Values clamp to
    <code>min</code>/<code>max</code> on blur.
  </p>
  <ComponentPreview react={codeReact} vue={codeVue}>
    <NumberInputDemo client:visible />
  </ComponentPreview>

  <h2 class="docs-h2">Inside a Form</h2>
  <p class="docs-p">
    Because <code>onChange</code> emits a number, <code>NumberInput</code>
    works in <code>FormField</code> with no glue code — the numeric value
    lands in form state and validation rules like <code>min</code> apply
    directly.
  </p>
  <pre class="docs-pre"><code set:text={codeForm} /></pre>

  <h2 class="docs-h2">Props</h2>
  <PropsTable props={props} />

  <AICheatSheet component="NumberInput" />

  <div class="docs-pagination">
    <a href="/docs/components/modal" class="docs-pagination__link docs-pagination__link--prev">
      ← Modal
    </a>
    <a href="/docs/components/pagination" class="docs-pagination__link docs-pagination__link--next">
      Pagination →
    </a>
  </div>
</DocsLayout>
