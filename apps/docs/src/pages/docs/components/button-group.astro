---
import DocsLayout       from "@/layouts/DocsLayout.astro";
import ComponentPreview from "@/components/docs/ComponentPreview.astro";
import PropsTable       from "@/components/docs/PropsTable.astro";
import AICheatSheet     from "@/components/docs/AICheatSheet.astro";
import { ButtonGroupBasicDemo, ButtonGroupAttachedDemo, ButtonGroupOrientationDemo } from "@/components/demos/NewComponentsDemo";

const codeBasicReact = `import { ButtonGroup, Button } from "@usevyre/react";

<ButtonGroup>
  <Button variant="secondary">Cut</Button>
  <Button variant="secondary">Copy</Button>
  <Button variant="secondary">Paste</Button>
</ButtonGroup>`;

const codeBasicVue = `<script setup>
import { ButtonGroup, Button } from "@usevyre/vue";
</script>
<template>
  <ButtonGroup>
    <Button variant="secondary">Cut</Button>
    <Button variant="secondary">Copy</Button>
    <Button variant="secondary">Paste</Button>
  </ButtonGroup>
</template>`;

const codeAttachedReact = `<ButtonGroup attached>
  <Button variant="primary">Day</Button>
  <Button variant="secondary">Week</Button>
  <Button variant="secondary">Month</Button>
</ButtonGroup>`;

const codeAttachedVue = `<ButtonGroup :attached="true">
  <Button variant="primary">Day</Button>
  <Button variant="secondary">Week</Button>
  <Button variant="secondary">Month</Button>
</ButtonGroup>`;

const codeVerticalReact = `<ButtonGroup orientation="vertical">
  <Button variant="ghost">Option A</Button>
  <Button variant="ghost">Option B</Button>
  <Button variant="ghost">Option C</Button>
</ButtonGroup>`;

const codeVerticalVue = `<ButtonGroup orientation="vertical">
  <Button variant="ghost">Option A</Button>
  <Button variant="ghost">Option B</Button>
  <Button variant="ghost">Option C</Button>
</ButtonGroup>`;

const props = [
  { name: "orientation", type: `"horizontal" | "vertical"`,  default: `"horizontal"`, description: "Layout direction of the grouped buttons." },
  { name: "attached",    type: "boolean",                    default: "false",         description: "Removes gap and collapses shared borders — turns the group into a segmented control." },
  { name: "size",        type: `"sm" | "md" | "lg" | "icon"`, default: `"md"`,        description: "Size forwarded to child buttons via data-group-size attribute." },
  { name: "className",   type: "string",                     default: "—",             description: "Additional CSS class." },
];
---

<DocsLayout title="Button Group" component="ButtonGroup">
  <div class="docs-header">
    <div class="docs-header__meta">
      <span class="vyre-badge vyre-badge--default">@usevyre/react</span>
      <span class="vyre-badge vyre-badge--default">@usevyre/vue</span>
    </div>
    <h1 class="docs-title">Button Group</h1>
    <p class="docs-lead">
      Groups related buttons into a single visual unit. Supports horizontal and vertical
      orientations, and an <code>attached</code> mode that collapses shared borders to
      create a segmented-control look.
    </p>
  </div>

  <hr class="docs-divider" />

  <h2 class="docs-h2">Basic</h2>
  <p class="docs-p">
    Wrap any number of <code>Button</code> components in a <code>ButtonGroup</code>.
    Buttons are spaced with a gap by default and rendered with a semantic <code>role="group"</code>.
  </p>
  <ComponentPreview react={codeBasicReact} vue={codeBasicVue}>
    <ButtonGroupBasicDemo client:visible />
  </ComponentPreview>

  <h2 class="docs-h2">Attached (segmented control)</h2>
  <p class="docs-p">
    Add <code>attached</code> to collapse the gap and merge adjacent borders. The outermost
    buttons retain their border-radius while inner buttons have flat edges — ideal for
    view-mode toggles (Day / Week / Month).
  </p>
  <ComponentPreview react={codeAttachedReact} vue={codeAttachedVue}>
    <ButtonGroupAttachedDemo client:visible />
  </ComponentPreview>

  <h2 class="docs-h2">Vertical orientation</h2>
  <p class="docs-p">
    Set <code>orientation="vertical"</code> to stack buttons in a column. Works with
    all variants and the <code>attached</code> prop.
  </p>
  <ComponentPreview react={codeVerticalReact} vue={codeVerticalVue}>
    <ButtonGroupOrientationDemo client:visible />
  </ComponentPreview>

  <h2 class="docs-h2">Props</h2>
  <PropsTable props={props} />

  <!-- AI Cheat Sheet -->
  <AICheatSheet component="ButtonGroup" />

  <div class="docs-pagination">
    <a href="/docs/components/button" class="docs-pagination__link docs-pagination__link--prev">
      ← Button
    </a>
    <a href="/docs/components/calendar" class="docs-pagination__link docs-pagination__link--next">
      Calendar →
    </a>
  </div>
</DocsLayout>
