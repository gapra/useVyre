---
import DocsLayout       from "@/layouts/DocsLayout.astro";
import {
  LineChartDemo,
  AreaChartDemo,
  BarChartDemo,
  PieChartDemo,
  SparklineDemo,
} from "@/components/demos/ChartsDemo";

const charts = [
  { title: "Line Chart",  href: "/docs/components/line-chart",  use: "Trends over time (revenue, signups). Multiple series, smooth curves." },
  { title: "Area Chart",  href: "/docs/components/area-chart",  use: "Volume / cumulative trends. Like Line but filled; gradient and stacked modes." },
  { title: "Bar Chart",   href: "/docs/components/bar-chart",   use: "Compare categories (sales per region). Grouped or stacked, vertical or horizontal." },
  { title: "Pie Chart",   href: "/docs/components/pie-chart",   use: "Parts of a whole (browser share). Pie or donut." },
  { title: "Sparkline",   href: "/docs/components/sparkline",   use: "Tiny inline chart for Stat cards and table cells. No axis/legend/tooltip." },
];
---

<DocsLayout title="Charts">
  <div class="docs-header">
    <div class="docs-header__meta">
      <span class="vyre-badge vyre-badge--default">@usevyre/react</span>
      <span class="vyre-badge vyre-badge--default">@usevyre/vue</span>
    </div>
    <h1 class="docs-title">Charts</h1>
    <p class="docs-lead">
      Five zero-dependency SVG charts — <strong>no Recharts, no D3</strong>. All are
      data-driven (<code>data</code> + a <code>config</code> map of
      <code>{`{ label, color }`}</code> per series), token-locked (colors come only
      from <code>--vyre-*</code> tokens), and ship gridlines, a hover tooltip, a
      click-to-toggle legend, and keyboard-accessible tooltips. Pick a chart below
      and follow its page for the full API.
    </p>
  </div>

  <hr class="docs-divider" />

  <h2 class="docs-h2">Which chart should I use?</h2>
  <div class="docs-table-wrapper">
    <table class="docs-table">
      <thead>
        <tr><th>Chart</th><th>Use it for</th></tr>
      </thead>
      <tbody>
        {charts.map((c) => (
          <tr>
            <td><a href={c.href} class="docs-link">{c.title}</a></td>
            <td>{c.use}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="docs-callout docs-callout--accent">
    <strong>Shared API:</strong> every chart (except Sparkline) takes
    <code>data</code>, a <code>config</code> object mapping each series key to
    <code>{`{ label, color }`}</code>, and <code>xKey</code>. Visibility of grid,
    legend and tooltip are boolean props (<code>showGrid</code>,
    <code>showLegend</code>, <code>showTooltip</code>). There is no <code>color</code>
    prop — colors live in <code>config</code> as <code>--vyre-*</code> tokens.
  </div>

  <hr class="docs-divider" />

  <h2 class="docs-h2">Line Chart</h2>
  <p class="docs-p">Time-series trends with multiple series. <a href="/docs/components/line-chart" class="docs-link">Full API →</a></p>
  <div class="docs-preview"><LineChartDemo client:visible /></div>

  <h2 class="docs-h2">Area Chart</h2>
  <p class="docs-p">Filled trends with gradient and stacking. <a href="/docs/components/area-chart" class="docs-link">Full API →</a></p>
  <div class="docs-preview"><AreaChartDemo client:visible /></div>

  <h2 class="docs-h2">Bar Chart</h2>
  <p class="docs-p">Category comparison, grouped or stacked. <a href="/docs/components/bar-chart" class="docs-link">Full API →</a></p>
  <div class="docs-preview"><BarChartDemo client:visible /></div>

  <h2 class="docs-h2">Pie Chart</h2>
  <p class="docs-p">Parts of a whole, pie or donut. <a href="/docs/components/pie-chart" class="docs-link">Full API →</a></p>
  <div class="docs-preview"><PieChartDemo client:visible /></div>

  <h2 class="docs-h2">Sparkline</h2>
  <p class="docs-p">Tiny inline chart for Stat cards and tables. <a href="/docs/components/sparkline" class="docs-link">Full API →</a></p>
  <div class="docs-preview"><SparklineDemo client:visible /></div>

  <div class="docs-pagination">
    <a href="/docs/components/carousel" class="docs-pagination__link docs-pagination__link--prev">
      ← Carousel
    </a>
    <a href="/docs/components/line-chart" class="docs-pagination__link docs-pagination__link--next">
      Charts — Line →
    </a>
  </div>
</DocsLayout>

<style>
  .docs-preview {
    padding: var(--vyre-spacing-6);
    border: 1px solid var(--vyre-color-semantic-border-subtle);
    border-radius: var(--vyre-border-radius-lg);
    background: var(--vyre-color-semantic-surface);
    margin-bottom: var(--vyre-spacing-4);
  }
</style>
