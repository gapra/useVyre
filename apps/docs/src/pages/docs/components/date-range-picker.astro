---
import DocsLayout       from "@/layouts/DocsLayout.astro";
import ComponentPreview from "@/components/docs/ComponentPreview.astro";
import PropsTable       from "@/components/docs/PropsTable.astro";
import AICheatSheet     from "@/components/docs/AICheatSheet.astro";
import {
  DateRangePickerBasicDemo,
  DateRangePickerPresetsDemo,
  DateRangePickerSingleMonthDemo,
} from "@/components/demos/Tier2Demo";

const codeBasicReact = `import { useState } from "react";
import { DateRangePicker } from "@usevyre/react";
import type { DateRange } from "@usevyre/react";

const [range, setRange] = useState<DateRange>({ from: null, to: null });

<DateRangePicker value={range} onChange={setRange} />`;

const codeBasicVue = `<script setup>
import { ref } from "vue";
import { DateRangePicker } from "@usevyre/vue";

const range = ref({ from: null, to: null });
</script>
<template>
  <DateRangePicker v-model="range" />
</template>`;

const codePresetsReact = `<DateRangePicker value={range} onChange={setRange} presets />

// or custom presets:
<DateRangePicker
  value={range}
  onChange={setRange}
  presets={[
    { label: "Q1", range: () => ({ from: new Date(2026, 0, 1), to: new Date(2026, 2, 31) }) },
  ]}
/>`;

const codePresetsVue = `<DateRangePicker v-model="range" presets />

<DateRangePicker
  v-model="range"
  :presets="[
    { label: 'Q1', range: () => ({ from: new Date(2026, 0, 1), to: new Date(2026, 2, 31) }) },
  ]"
/>`;

const codeSingleReact = `<DateRangePicker value={range} onChange={setRange} numberOfMonths={1} />`;
const codeSingleVue   = `<DateRangePicker v-model="range" :number-of-months="1" />`;

const props = [
  { name: "value",          type: "{ from: Date | null; to: Date | null } | null", default: "—",                  description: "Selected range (controlled). Pass an object — NOT a [Date, Date] tuple." },
  { name: "onChange",       type: "(range: DateRange) => void",                    default: "—",                  description: "Called with { from, to } whenever the range changes." },
  { name: "placeholder",    type: "string",                                        default: `"Pick a date range"`, description: "Trigger text shown when no range is selected." },
  { name: "numberOfMonths", type: "1 | 2",                                         default: "2",                  description: "How many month calendars to display side-by-side." },
  { name: "presets",        type: "boolean | DateRangePreset[]",                   default: "false",              description: "true shows built-in presets (Today, Yesterday, Last 7/30 days, This/Last month); or pass a custom { label, range() } array." },
  { name: "minDate",        type: "Date",                                          default: "—",                  description: "Earliest selectable date." },
  { name: "maxDate",        type: "Date",                                          default: "—",                  description: "Latest selectable date." },
  { name: "disabled",       type: "(date: Date) => boolean",                       default: "—",                  description: "Return true to disable specific dates." },
  { name: "weekStartsOn",   type: "0 | 1",                                         default: "1",                  description: "0 = Sunday, 1 = Monday." },
  { name: "className",      type: "string",                                        default: "—",                  description: "Additional CSS class on the wrapper." },
];
---

<DocsLayout title="Date Range Picker" component="DateRangePicker">
  <div class="docs-header">
    <div class="docs-header__meta">
      <span class="vyre-badge vyre-badge--default">@usevyre/react</span>
      <span class="vyre-badge vyre-badge--default">@usevyre/vue</span>
    </div>
    <h1 class="docs-title">Date Range Picker</h1>
    <p class="docs-lead">
      Select a start and end date in one control. Built on top of <code>Calendar</code>
      with a friendlier <code>&#123; from, to &#125;</code> object API, a two-month side-by-side
      view, and optional preset shortcuts. Reach for <code>DatePicker</code> when you
      only need a single date.
    </p>
  </div>

  <hr class="docs-divider" />

  <h2 class="docs-h2">Basic</h2>
  <p class="docs-p">
    Pass a controlled <code>&#123; from, to &#125;</code> object as <code>value</code> and read
    the next range from <code>onChange</code>. Two months are shown by default; the
    popover closes automatically once both ends are picked.
  </p>
  <ComponentPreview react={codeBasicReact} vue={codeBasicVue}>
    <DateRangePickerBasicDemo client:visible />
  </ComponentPreview>

  <h2 class="docs-h2">With presets</h2>
  <p class="docs-p">
    Add the <code>presets</code> prop for a shortcut column — pass <code>true</code>
    for the built-in set (Today, Yesterday, Last 7 / 30 days, This month, Last month)
    or supply your own array of <code>&#123; label, range() &#125;</code> entries.
  </p>
  <ComponentPreview react={codePresetsReact} vue={codePresetsVue}>
    <DateRangePickerPresetsDemo client:visible />
  </ComponentPreview>

  <h2 class="docs-h2">Single month</h2>
  <p class="docs-p">
    Set <code>numberOfMonths=&#123;1&#125;</code> for tight layouts or mobile — range
    highlighting still works across month navigation.
  </p>
  <ComponentPreview react={codeSingleReact} vue={codeSingleVue}>
    <DateRangePickerSingleMonthDemo client:visible />
  </ComponentPreview>

  <h2 class="docs-h2">Props</h2>
  <PropsTable props={props} />

  <!-- AI Cheat Sheet -->
  <AICheatSheet component="DateRangePicker" />

  <div class="docs-pagination">
    <a href="/docs/components/data-grid" class="docs-pagination__link docs-pagination__link--prev">
      ← Data Grid
    </a>
    <a href="/docs/components/dropdown-menu" class="docs-pagination__link docs-pagination__link--next">
      Dropdown Menu →
    </a>
  </div>
</DocsLayout>
