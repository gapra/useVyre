---
import DocsLayout       from "@/layouts/DocsLayout.astro";
import ComponentPreview from "@/components/docs/ComponentPreview.astro";
import PropsTable       from "@/components/docs/PropsTable.astro";
import AICheatSheet     from "@/components/docs/AICheatSheet.astro";
import { CarouselDemo } from "@/components/demos/CarouselDemo";

const codeReact = `import { useState } from "react";
import { Carousel, CarouselSlide } from "@usevyre/react";

const [i, setI] = useState(0);

<Carousel value={i} onChange={setI} loop>
  <CarouselSlide>
    <img src="/welcome.jpg" alt="Welcome" />
  </CarouselSlide>
  <CarouselSlide>
    <img src="/compose.jpg" alt="Compose" />
  </CarouselSlide>
  <CarouselSlide>
    <img src="/ship.jpg" alt="Ship" />
  </CarouselSlide>
</Carousel>`;

const codeVue = `<script setup>
import { ref } from "vue";
import { Carousel, CarouselSlide } from "@usevyre/vue";

const i = ref(0);
</script>
<template>
  <Carousel v-model="i" loop>
    <CarouselSlide>
      <img src="/welcome.jpg" alt="Welcome" />
    </CarouselSlide>
    <CarouselSlide>
      <img src="/compose.jpg" alt="Compose" />
    </CarouselSlide>
    <CarouselSlide>
      <img src="/ship.jpg" alt="Ship" />
    </CarouselSlide>
  </Carousel>
</template>`;

const props = [
  { name: "value",          type: "number", default: "—", description: "Controlled active slide (0-based). Omit for uncontrolled." },
  { name: "defaultValue",   type: "number", default: "0", description: "Initial slide when uncontrolled." },
  { name: "onChange",       type: "(index: number) => void", default: "—", description: "Emits the new slide index. Not an event." },
  { name: "loop",           type: "boolean", default: "false", description: "Wrap past the first/last slide." },
  { name: "autoPlay",       type: "boolean", default: "false", description: "Advance automatically; pauses on hover/focus." },
  { name: "interval",       type: "number", default: "5000", description: "Autoplay interval in ms." },
  { name: "showArrows",     type: "boolean", default: "true", description: "Show prev/next arrow buttons." },
  { name: "showIndicators", type: "boolean", default: "true", description: "Show clickable dot indicators." },
];
---

<DocsLayout title="Carousel" component="Carousel">
  <div class="docs-header">
    <div class="docs-header__meta">
      <span class="vyre-badge vyre-badge--default">@usevyre/react</span>
      <span class="vyre-badge vyre-badge--default">@usevyre/vue</span>
    </div>
    <h1 class="docs-title">Carousel</h1>
    <p class="docs-lead">
      An accessible content slider for galleries, onboarding, and
      testimonials. Controlled by a 0-based index; compose
      <code>CarouselSlide</code> children. Snap scrolling, clickable dots,
      prev/next arrows, <kbd>←</kbd>/<kbd>→</kbd> keyboard, optional
      <code>loop</code> and <code>autoPlay</code> (which pauses on
      hover/focus).
    </p>
  </div>

  <hr class="docs-divider" />

  <h2 class="docs-h2">Gallery with loop</h2>
  <p class="docs-p">
    Drag/scroll, click a dot, use the arrows, or focus the track and press
    <kbd>←</kbd>/<kbd>→</kbd>. With <code>loop</code>, the ends wrap.
  </p>
  <ComponentPreview react={codeReact} vue={codeVue}>
    <CarouselDemo client:visible />
  </ComponentPreview>

  <h2 class="docs-h2">Props</h2>
  <PropsTable props={props} />

  <div class="docs-callout docs-callout--accent">
    <strong>Slides must be <code>CarouselSlide</code>.</strong> Snap, indices,
    and ARIA roles depend on it — so AI can’t produce a broken slider from raw
    divs.
  </div>

  <AICheatSheet component="Carousel" />

  <div class="docs-pagination">
    <a href="/docs/components/card" class="docs-pagination__link docs-pagination__link--prev">
      ← Card
    </a>
    <a href="/docs/components/checkbox" class="docs-pagination__link docs-pagination__link--next">
      Checkbox →
    </a>
  </div>
</DocsLayout>
