---
import DocsLayout       from "@/layouts/DocsLayout.astro";
import ComponentPreview from "@/components/docs/ComponentPreview.astro";
import PropsTable       from "@/components/docs/PropsTable.astro";
import AICheatSheet     from "@/components/docs/AICheatSheet.astro";
import { PieChartDemo } from "@/components/demos/ChartsDemo";

const codeReact = `import { PieChart, Card, CardBody } from "@usevyre/react";

const data = [
  { name: "Chrome",  value: 62 },
  { name: "Safari",  value: 19 },
  { name: "Firefox", value: 9 },
  { name: "Edge",    value: 7 },
  { name: "Other",   value: 3 },
];

const config = {
  Chrome:  { label: "Chrome",  color: "var(--vyre-color-semantic-accent)" },
  Safari:  { label: "Safari",  color: "var(--vyre-color-semantic-teal)" },
  Firefox: { label: "Firefox", color: "var(--vyre-color-semantic-warning)" },
  Edge:    { label: "Edge",    color: "var(--vyre-color-semantic-success)" },
  Other:   { label: "Other",   color: "var(--vyre-color-semantic-danger)" },
};

<Card>
  <CardBody>
    <PieChart data={data} config={config} donut />
  </CardBody>
</Card>`;

const codeVue = `<script setup>
import { PieChart, Card, CardBody } from "@usevyre/vue";

const data = [
  { name: "Chrome",  value: 62 },
  { name: "Safari",  value: 19 },
  { name: "Firefox", value: 9 },
  { name: "Edge",    value: 7 },
  { name: "Other",   value: 3 },
];

const config = {
  Chrome:  { label: "Chrome",  color: "var(--vyre-color-semantic-accent)" },
  Safari:  { label: "Safari",  color: "var(--vyre-color-semantic-teal)" },
  Firefox: { label: "Firefox", color: "var(--vyre-color-semantic-warning)" },
  Edge:    { label: "Edge",    color: "var(--vyre-color-semantic-success)" },
  Other:   { label: "Other",   color: "var(--vyre-color-semantic-danger)" },
};
</script>
<template>
  <Card>
    <CardBody>
      <PieChart :data="data" :config="config" donut />
    </CardBody>
  </Card>
</template>`;

const props = [
  { name: "data",        type: "PieDatum[]", default: "—", description: "Flat array of { name: string; value: number } objects (required), e.g. [{ name: \"Chrome\", value: 60 }].", required: true },
  { name: "config",      type: "ChartConfig", default: "—", description: "Optional per-segment settings: { name: { label, color } }. Unmatched names use a token color cycle." },
  { name: "donut",       type: "boolean", default: "false", description: "Render a hollow-center donut instead of a full pie." },
  { name: "size",        type: "number", default: "240", description: "SVG width AND height in px (the chart is square)." },
  { name: "showLegend",  type: "boolean", default: "true", description: "Show the legend; clicking a legend item toggles that segment." },
  { name: "showTooltip", type: "boolean", default: "true", description: "Show the hover tooltip." },
];
---

<DocsLayout title="Pie Chart" component="PieChart">
  <div class="docs-header">
    <div class="docs-header__meta">
      <span class="vyre-badge vyre-badge--default">@usevyre/react</span>
      <span class="vyre-badge vyre-badge--default">@usevyre/vue</span>
    </div>
    <h1 class="docs-title">Pie Chart</h1>
    <p class="docs-lead">
      A single-level pie / donut chart. It takes <strong>flat</strong> data — an
      array of <code>{`{ name, value }`}</code> objects (<em>not</em> multi-series
      rows, and <em>not</em> a list of numbers). <code>config</code> is optional
      (<code>{`{ name: { label, color } }`}</code>); names without a config entry
      fall back to a built-in token color cycle. There is no <code>color</code> prop
      and no <code>&lt;Pie&gt;</code>/<code>&lt;Cell&gt;</code> children.
    </p>
  </div>

  <hr class="docs-divider" />

  <h2 class="docs-h2">Donut with per-segment colors</h2>
  <p class="docs-p">
    Browser share as flat <code>{`{ name, value }`}</code> data, rendered as a
    <code>donut</code>. Each segment’s color is set via <code>config</code> using a
    <code>--vyre-*</code> token; omit <code>config</code> to use the automatic token
    cycle instead.
  </p>
  <ComponentPreview react={codeReact} vue={codeVue}>
    <PieChartDemo client:visible />
  </ComponentPreview>

  <h2 class="docs-h2">Props</h2>
  <PropsTable props={props} />

  <div class="docs-callout docs-callout--accent">
    <strong>Flat <code>{`{ name, value }`}</code> data only.</strong> Pass named
    segments (not numbers, not multi-series rows). Per-segment color comes from
    <code>config</code> or the built-in token cycle — there is no <code>color</code>
    prop and no <code>&lt;Pie&gt;</code>/<code>&lt;Cell&gt;</code> children.
  </div>

  <AICheatSheet component="PieChart" />

  <div class="docs-pagination">
    <a href="/docs/components/pagination" class="docs-pagination__link docs-pagination__link--prev">
      ← Pagination
    </a>
    <a href="/docs/components/popover" class="docs-pagination__link docs-pagination__link--next">
      Popover →
    </a>
  </div>
</DocsLayout>
