---
import DocsLayout       from "@/layouts/DocsLayout.astro";
import ComponentPreview from "@/components/docs/ComponentPreview.astro";
import PropsTable       from "@/components/docs/PropsTable.astro";
import AICheatSheet     from "@/components/docs/AICheatSheet.astro";
import { StatDemo, StatDecoupledDemo } from "@/components/demos/StatDemo";

const codeReact = `import { Stat, StatGroup, Card, CardBody } from "@usevyre/react";

<Card>
  <CardBody>
    <StatGroup>
      <Stat
        label="Revenue"
        value="$48.2k"
        delta="+12%"
        trend="up"
        deltaLabel="+ → up → green"
      />
      <Stat
        label="Refunds"
        value="312"
        delta="-18%"
        trend="down"
        deltaLabel="− → down → red"
      />
      <Stat
        label="Orders"
        value="1,204"
        delta="0%"
        trend="neutral"
        deltaLabel="0 → flat → grey"
      />
    </StatGroup>
  </CardBody>
</Card>`;

const codeVue = `<script setup>
import { Stat, StatGroup, Card, CardBody } from "@usevyre/vue";
</script>
<template>
  <Card>
    <CardBody>
      <StatGroup>
        <Stat
          label="Revenue"
          value="$48.2k"
          delta="+12%"
          trend="up"
          delta-label="+ → up → green"
        />
        <Stat
          label="Refunds"
          value="312"
          delta="-18%"
          trend="down"
          delta-label="− → down → red"
        />
        <Stat
          label="Orders"
          value="1,204"
          delta="0%"
          trend="neutral"
          delta-label="0 → flat → grey"
        />
      </StatGroup>
    </CardBody>
  </Card>
</template>`;

const codeDecoupledReact = `import { Stat, Card, CardBody, Stack } from "@usevyre/react";

<Stack direction="row" gap="md">
  {/* delta is negative → DOWN arrow; trend=up → GREEN (good) */}
  <Card style={{ flex: 1 }}>
    <CardBody>
      <Stat
        label="Churn"
        value="2.1%"
        delta="-0.4%"
        trend="up"
        deltaLabel="down arrow, green (good)"
      />
    </CardBody>
  </Card>
  {/* delta is positive → UP arrow; trend=down → RED (bad) */}
  <Card style={{ flex: 1 }}>
    <CardBody>
      <Stat
        label="Error rate"
        value="1.8%"
        delta="+0.3%"
        trend="down"
        deltaLabel="up arrow, red (bad)"
      />
    </CardBody>
  </Card>
</Stack>`;

const codeDecoupledVue = `<script setup>
import { Stat, Card, CardBody, Stack } from "@usevyre/vue";
</script>
<template>
  <Stack direction="row" gap="md">
    <!-- delta negative → DOWN arrow; trend=up → GREEN (good) -->
    <Card style="flex:1">
      <CardBody>
        <Stat
          label="Churn"
          value="2.1%"
          delta="-0.4%"
          trend="up"
          delta-label="down arrow, green (good)"
        />
      </CardBody>
    </Card>
    <!-- delta positive → UP arrow; trend=down → RED (bad) -->
    <Card style="flex:1">
      <CardBody>
        <Stat
          label="Error rate"
          value="1.8%"
          delta="+0.3%"
          trend="down"
          delta-label="up arrow, red (bad)"
        />
      </CardBody>
    </Card>
  </Stack>
</template>`;

const props = [
  { name: "label",      type: "string", default: "—", description: "Metric name (required)." },
  { name: "value",      type: "string | number", default: "—", description: "The headline figure (required, rendered large)." },
  { name: "delta",      type: "string | number", default: "—", description: 'The change amount, e.g. "+12%" or 24.' },
  { name: "trend",      type: `"up" | "down" | "neutral"`, default: `"neutral"`, description: "Sets the delta color explicitly — up=success, down=danger, neutral=muted. Not inferred from the sign." },
  { name: "deltaLabel", type: "string", default: "—", description: 'Context for the delta, e.g. "vs last month".' },
  { name: "icon",       type: "ReactNode", default: "—", description: "Optional leading icon (Vue: #icon slot)." },
  { name: "size",       type: `"sm" | "md" | "lg"`, default: `"md"`, description: "Value size." },
];
---

<DocsLayout title="Stat" component="Stat">
  <div class="docs-header">
    <div class="docs-header__meta">
      <span class="vyre-badge vyre-badge--default">@usevyre/react</span>
      <span class="vyre-badge vyre-badge--default">@usevyre/vue</span>
    </div>
    <h1 class="docs-title">Stat</h1>
    <p class="docs-lead">
      A dashboard KPI: a label, a large value, and an optional delta. The
      arrow <strong>direction</strong> follows the sign of <code>delta</code>
      (it falls → arrow points down). The <strong>color</strong> is set
      separately by <code>trend</code> — so a “lower is better” metric (churn,
      bounce) shows a green <em>down</em> arrow. Wrap several in
      <code>StatGroup</code> for an evenly-split row.
    </p>
  </div>

  <hr class="docs-divider" />

  <h2 class="docs-h2">Trend colors</h2>
  <p class="docs-p">
    <code>trend</code> sets the color: <code>"up"</code> is green,
    <code>"down"</code> is red, <code>"neutral"</code> is grey. Here each
    column shows one so the difference is visible side by side.
  </p>
  <ComponentPreview react={codeReact} vue={codeVue}>
    <StatDemo client:visible />
  </ComponentPreview>

  <h2 class="docs-h2">Direction vs. color (decoupled)</h2>
  <p class="docs-p">
    The arrow <em>direction</em> follows the sign of <code>delta</code>;
    the <em>color</em> follows <code>trend</code> — they are independent.
    Left: churn falls (<code>-0.4%</code>, down arrow) but that is good, so
    <code>trend="up"</code> colors it green. Right: error rate rises
    (<code>+0.3%</code>, up arrow) but that is bad, so
    <code>trend="down"</code> colors it red.
  </p>
  <ComponentPreview react={codeDecoupledReact} vue={codeDecoupledVue}>
    <StatDecoupledDemo client:visible />
  </ComponentPreview>

  <h2 class="docs-h2">Props</h2>
  <PropsTable props={props} />

  <div class="docs-callout docs-callout--accent">
    <strong>Direction vs. color.</strong> The arrow direction always reflects
    the real change (sign of <code>delta</code>); <code>trend</code> only sets
    the color. That keeps “lower is better” metrics honest — a true down
    arrow, colored green.
  </div>

  <AICheatSheet component="Stat" />

  <div class="docs-pagination">
    <a href="/docs/components/stack" class="docs-pagination__link docs-pagination__link--prev">
      ← Stack
    </a>
    <a href="/docs/components/stepper" class="docs-pagination__link docs-pagination__link--next">
      Stepper →
    </a>
  </div>
</DocsLayout>
