---
import DocsLayout         from "@/layouts/DocsLayout.astro";
import ComponentPreview   from "@/components/docs/ComponentPreview.astro";
import PropsTable         from "@/components/docs/PropsTable.astro";
import AICheatSheet       from "@/components/docs/AICheatSheet.astro";
import { EmptyStateDemo } from "@/components/demos/EmptyStateDemo";

const codeReact = `import { EmptyState, Button } from "@usevyre/react";

<EmptyState
  title="No projects yet"
  description="Create your first project to get started."
>
  <Button variant="primary">New project</Button>
</EmptyState>

<EmptyState
  variant="search"
  size="sm"
  title="No results"
  description="Try a different search term."
>
  <Button variant="secondary">Clear filters</Button>
</EmptyState>

<EmptyState
  variant="error"
  title="Couldn't load data"
  description="Something went wrong. Please try again."
>
  <Button variant="secondary">Retry</Button>
</EmptyState>`;

const codeVue = `<script setup>
import { EmptyState, Button } from "@usevyre/vue";
</script>
<template>
  <EmptyState
    title="No projects yet"
    description="Create your first project to get started."
  >
    <Button variant="primary">New project</Button>
  </EmptyState>

  <EmptyState
    variant="search"
    size="sm"
    title="No results"
    description="Try a different search term."
  >
    <Button variant="secondary">Clear filters</Button>
  </EmptyState>

  <EmptyState
    variant="error"
    title="Couldn't load data"
    description="Something went wrong. Please try again."
  >
    <Button variant="secondary">Retry</Button>
  </EmptyState>
</template>`;

const props = [
  { name: "title",       type: "string", default: "—", description: "Headline (required)." },
  { name: "description", type: "string", default: "—", description: "Supporting text under the title." },
  { name: "variant",     type: `"default" | "search" | "error"`, default: `"default"`, description: "Preset icon: box / magnifier / warning." },
  { name: "icon",        type: "ReactNode", default: "—", description: "Custom icon — overrides the variant preset (Vue: #icon slot)." },
  { name: "size",        type: `"sm" | "md" | "lg"`, default: `"md"`, description: "sm for inline/in-Card, lg for full-page." },
  { name: "children",    type: "ReactNode", default: "—", description: "The call-to-action (a Button, or buttons in a Stack)." },
];
---

<DocsLayout title="Empty State" component="EmptyState">
  <div class="docs-header">
    <div class="docs-header__meta">
      <span class="vyre-badge vyre-badge--default">@usevyre/react</span>
      <span class="vyre-badge vyre-badge--default">@usevyre/vue</span>
    </div>
    <h1 class="docs-title">Empty State</h1>
    <p class="docs-lead">
      A consistent placeholder for empty lists, tables, and search results.
      Pick a <code>variant</code> for a preset icon, set
      <code>title</code>/<code>description</code>, and compose the
      call-to-action as children. Use it for <em>no data</em> — not loading
      (reach for <a href="/docs/components/skeleton">Skeleton</a> there).
    </p>
  </div>

  <hr class="docs-divider" />

  <h2 class="docs-h2">Default, search & error</h2>
  <p class="docs-p">
    <code>variant="default"</code> shows a box, <code>"search"</code> a
    magnifier, <code>"error"</code> a warning (tinted danger). Each takes an
    optional CTA via children.
  </p>
  <ComponentPreview react={codeReact} vue={codeVue}>
    <EmptyStateDemo client:visible />
  </ComponentPreview>

  <h2 class="docs-h2">Props</h2>
  <PropsTable props={props} />

  <AICheatSheet component="EmptyState" />

  <div class="docs-pagination">
    <a href="/docs/components/dropdown-menu" class="docs-pagination__link docs-pagination__link--prev">
      ← Dropdown Menu
    </a>
    <a href="/docs/components/field" class="docs-pagination__link docs-pagination__link--next">
      Field →
    </a>
  </div>
</DocsLayout>
