---
import DocsLayout from "@/layouts/DocsLayout.astro";
import { Code }   from "astro:components";

const installReact = `npm install @vyre/react @vyre/tokens`;
const installVue   = `npm install @vyre/vue @vyre/tokens`;

const setupReact = `// main.tsx or your entry file
import "@vyre/tokens/css";        // ← design tokens
import "@vyre/react/styles";      // ← component styles

import { Button, Badge, Card } from "@vyre/react";`;

const setupVue = `// main.ts
import "@vyre/tokens/css";
import "@vyre/vue/styles";

import { createApp } from "vue";
import App from "./App.vue";

createApp(App).mount("#app");`;

const usageReact = `import { Button, Badge, Card, CardBody } from "@vyre/react";
import { ToastProvider, useToast } from "@vyre/react";

// Wrap your app with ToastProvider
function App() {
  return (
    <ToastProvider>
      <MyPage />
    </ToastProvider>
  );
}

function MyPage() {
  const { toast } = useToast();

  return (
    <Card variant="elevated">
      <CardBody>
        <Badge variant="success">Live</Badge>
        <Button
          variant="accent"
          onClick={() => toast({ title: "Saved!", variant: "success" })}
        >
          Save changes
        </Button>
      </CardBody>
    </Card>
  );
}`;

const usageVue = `<!-- App.vue -->
<script setup lang="ts">
import { ToastViewport } from "@vyre/vue";
</script>
<template>
  <RouterView />
  <ToastViewport />
</template>

<!-- MyPage.vue -->
<script setup lang="ts">
import { Button, Badge, Card, CardBody } from "@vyre/vue";
import { useToast } from "@vyre/vue";
const { toast } = useToast();
</script>
<template>
  <Card variant="elevated">
    <CardBody>
      <Badge variant="success">Live</Badge>
      <Button variant="accent" @click="toast({ title: 'Saved!', variant: 'success' })">
        Save changes
      </Button>
    </CardBody>
  </Card>
</template>`;

const aiContextSetup = `# Add to CLAUDE.md, .cursor/rules, or AGENTS.md
# (auto-generate with: npx @vyre/ai-context init --claude)

$(cat node_modules/@vyre/tokens/dist/ai-context.md)`;
---

<DocsLayout title="Getting Started">
  <div class="docs-header">
    <h1 class="docs-title">Getting Started</h1>
    <p class="docs-lead">
      Install useVyre, import the styles, and start building — in React or Vue.
      Your AI agent will know exactly what to generate.
    </p>
  </div>

  <hr class="docs-divider" />

  <h2 class="docs-h2">Installation</h2>

  <div class="docs-tabs" id="install-tabs">
    <div class="docs-tabs__bar" role="tablist">
      <button class="docs-tabs__tab docs-tabs__tab--active" role="tab" data-target="install-react" type="button">React</button>
      <button class="docs-tabs__tab" role="tab" data-target="install-vue" type="button">Vue</button>
    </div>
    <div id="install-react" class="docs-tabs__panel">
      <Code code={installReact} lang="bash" theme="github-dark" />
    </div>
    <div id="install-vue" class="docs-tabs__panel" hidden>
      <Code code={installVue} lang="bash" theme="github-dark" />
    </div>
  </div>

  <h2 class="docs-h2">Setup</h2>
  <p class="docs-p">
    Import the tokens CSS and component styles once at your app entry point.
  </p>

  <div class="docs-tabs" id="setup-tabs">
    <div class="docs-tabs__bar" role="tablist">
      <button class="docs-tabs__tab docs-tabs__tab--active" role="tab" data-target="setup-react" type="button">React</button>
      <button class="docs-tabs__tab" role="tab" data-target="setup-vue" type="button">Vue</button>
    </div>
    <div id="setup-react" class="docs-tabs__panel">
      <Code code={setupReact} lang="tsx" theme="github-dark" />
    </div>
    <div id="setup-vue" class="docs-tabs__panel" hidden>
      <Code code={setupVue} lang="ts" theme="github-dark" />
    </div>
  </div>

  <h2 class="docs-h2">Usage</h2>

  <div class="docs-tabs" id="usage-tabs">
    <div class="docs-tabs__bar" role="tablist">
      <button class="docs-tabs__tab docs-tabs__tab--active" role="tab" data-target="usage-react" type="button">React</button>
      <button class="docs-tabs__tab" role="tab" data-target="usage-vue" type="button">Vue</button>
    </div>
    <div id="usage-react" class="docs-tabs__panel">
      <Code code={usageReact} lang="tsx" theme="github-dark" />
    </div>
    <div id="usage-vue" class="docs-tabs__panel" hidden>
      <Code code={usageVue} lang="vue" theme="github-dark" />
    </div>
  </div>

  <h2 class="docs-h2">Set up AI context</h2>
  <p class="docs-p">
    The real power of useVyre is the AI context file. Add it to your project's
    agent rules so your coding agent knows every valid prop and variant.
  </p>

  <div class="docs-callout docs-callout--teal">
    <strong>Why this matters:</strong> Without context, AI agents invent props that
    don't exist. With it, they generate correct, type-safe component code on the first try.
  </div>

  <Code code={aiContextSetup} lang="bash" theme="github-dark" />

  <p class="docs-p">
    Or manually copy the contents of
    <code>node_modules/@vyre/tokens/dist/ai-context.md</code> into your agent rules file.
  </p>

  <div class="docs-next">
    <a href="/docs/components/button" class="docs-next__link">
      <span class="docs-next__label">Next</span>
      <span class="docs-next__title">Button →</span>
    </a>
  </div>
</DocsLayout>

<script>
  // Shared tab switcher for all .docs-tabs on this page
  document.querySelectorAll(".docs-tabs").forEach((wrapper) => {
    const tabs   = wrapper.querySelectorAll<HTMLButtonElement>(".docs-tabs__tab");
    const panels = wrapper.querySelectorAll<HTMLElement>(".docs-tabs__panel");
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        tabs.forEach((t) => { t.classList.remove("docs-tabs__tab--active"); t.setAttribute("aria-selected", "false"); });
        panels.forEach((p) => { p.hidden = true; });
        tab.classList.add("docs-tabs__tab--active");
        const target = document.getElementById(tab.dataset.target!);
        if (target) target.hidden = false;
      });
    });
  });
</script>
