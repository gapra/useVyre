</style>

<script>
  document.querySelectorAll(".docs-tabs").forEach((wrapper) => {
    const tabs   = wrapper.querySelectorAll<HTMLButtonElement>(".docs-tabs__tab");
    const panels = wrapper.querySelectorAll<HTMLElement>(".docs-tabs__panel");
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        tabs.forEach((t)   => t.classList.remove("docs-tabs__tab--active"));
        panels.forEach((p) => { p.hidden = true; });
        tab.classList.add("docs-tabs__tab--active");
        const target = document.getElementById(tab.dataset.target!);
        if (target) target.hidden = false;
      });
    });
  });
</script>
