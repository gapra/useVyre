}
.ai-context-faq__a :global(.astro-code) { margin: 10px 0 0; }

/* ── Coverage grid ────────────────────────────────────── */
.ai-context-coverage {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin: 16px 0;
}
.ai-context-coverage__item {
