---
import BaseLayout from "@/layouts/BaseLayout.astro";
import TopNav     from "@/components/layout/TopNav.astro";
import HeroDemo   from "@/components/demos/HeroDemo";
---

<BaseLayout title="AI-native design system for React and Vue">
  <TopNav />

  <!-- ── HERO ──────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero__inner">
      <div class="hero__content">
        <div class="hero__eyebrow">
          <span class="vyre-badge vyre-badge--teal">Open source</span>
          <span class="hero__eyebrow-text">React + Vue · Zero runtime</span>
        </div>

        <h1 class="hero__title">
          The design system<br/>
          <span class="hero__title-accent">AI agents understand</span>
        </h1>

        <p class="hero__description">
          useVyre ships semantic tokens, accessible components, and inline AI context blocks.
          Every variant, every prop — documented for agents so they stop hallucinating your UI.
        </p>

        <div class="hero__actions">
          <a href="/docs/getting-started" class="vyre-btn vyre-btn--accent vyre-btn--lg">
            Get started
          </a>
          <a
            href="https://github.com/gapra/usevyre"
            class="vyre-btn vyre-btn--secondary vyre-btn--lg"
            target="_blank" rel="noopener noreferrer"
          >
            <span class="vyre-btn__label">GitHub</span>
          </a>
        </div>

        <p class="hero__install">
          <code>npm install @vyre/react @vyre/tokens</code>
        </p>
      </div>

      <div class="hero__visual">
        <HeroDemo client:visible />

        <!-- AI Context preview -->
        <div class="hero__context-card">
          <p class="hero__context-label">AI CONTEXT</p>
          <pre class="hero__context-code"><code>variant = "primary"|"secondary"|"ghost"|
          "accent"|"teal"|"danger"
size     = "sm"|"md"|"lg"|"icon"
loading  = boolean</code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- ── PROBLEM ────────────────────────────────────────────────── -->
  <section class="problem">
    <div class="section-inner">
      <h2 class="problem__title">AI coding agents break on design systems.</h2>
      <p class="problem__body">
        When you ask Copilot or Claude to build UI, they invent class names, guess props,
        and hallucinate variants that don't exist. The reason: design systems are built for humans,
        not for language models.
      </p>
      <p class="problem__body">
        useVyre is built with AI agents as a first-class consumer. Every component carries
        an inline context block that tells the agent exactly what props, variants, and patterns
        are valid — and nothing else.
      </p>
    </div>
  </section>

  <!-- ── FEATURES ───────────────────────────────────────────────── -->
  <section class="features">
    <div class="section-inner">
      <h2 class="section-title">Built different</h2>
      <div class="feature-grid">

        <div class="feature-card">
          <div class="feature-card__icon">◈</div>
          <h3 class="feature-card__title">Semantic tokens</h3>
          <p class="feature-card__body">
            <code>--vyre-color-semantic-accent</code> not <code>--amber-400</code>.
            Token names describe intent. AI reads intent, not hex values.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-card__icon">⌥</div>
          <h3 class="feature-card__title">Inline AI context</h3>
          <p class="feature-card__body">
            Every component has a structured comment block listing all valid props and variants.
            Inject it into <code>CLAUDE.md</code>, <code>.cursor/rules</code>, or <code>AGENTS.md</code>.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-card__icon">◉</div>
          <h3 class="feature-card__title">Zero runtime</h3>
          <p class="feature-card__body">
            Pure CSS variables. Works in React, Vue, Svelte, plain HTML — anywhere.
            No JS bundle overhead. No framework lock-in.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-card__icon">⬡</div>
          <h3 class="feature-card__title">React + Vue</h3>
          <p class="feature-card__body">
            <code>@vyre/react</code> and <code>@vyre/vue</code> — identical API,
            identical CSS classes, one design system. Same agent context for both.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-card__icon">⌘</div>
          <h3 class="feature-card__title">DTCG tokens</h3>
          <p class="feature-card__body">
            W3C Design Token Community Group 2025 format. Interoperable with Figma,
            Style Dictionary, and any other token toolchain.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-card__icon">◎</div>
          <h3 class="feature-card__title">Accessible first</h3>
          <p class="feature-card__body">
            WAI-ARIA patterns, focus management, keyboard navigation — built in,
            not bolted on. Agents generate accessible UI without extra prompting.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- ── COMPONENT SHOWCASE ─────────────────────────────────────── -->
  <section class="showcase">
    <div class="section-inner">
      <h2 class="section-title">Components that speak agent</h2>
      <p class="section-subtitle">
        11 components across React and Vue. Every one ships with an AI context block.
      </p>

      <div class="showcase-grid">
        {[
          { name: "Button",  variants: "primary · secondary · ghost · accent · teal · danger" },
          { name: "Badge",   variants: "default · accent · teal · success · warning · danger" },
          { name: "Card",    variants: "default · elevated · outlined · ghost · accent" },
          { name: "Input",   variants: "sm · md · lg · with icons" },
          { name: "Modal",   variants: "sm · md · lg · full · focus trap" },
          { name: "Select",  variants: "keyboard nav · controlled · uncontrolled" },
          { name: "Tabs",    variants: "WAI-ARIA · keyboard nav · controlled" },
          { name: "Toast",   variants: "default · success · warning · danger" },
          { name: "Tooltip", variants: "top · bottom · left · right · delay" },
        ].map((c) => (
          <a href={`/docs/components/${c.name.toLowerCase()}`} class="showcase-item">
            <span class="showcase-item__name">{c.name}</span>
            <span class="showcase-item__variants">{c.variants}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA ────────────────────────────────────────────────────── -->
  <section class="cta">
    <div class="section-inner cta__inner">
      <h2 class="cta__title">Stop prompting. Start shipping.</h2>
      <p class="cta__body">
        Add useVyre to your project and let your AI agent build correct UI on the first try.
      </p>
      <div class="cta__actions">
        <a href="/docs/getting-started" class="vyre-btn vyre-btn--accent vyre-btn--lg">
          Read the docs
        </a>
        <a href="/docs/ai-context" class="vyre-btn vyre-btn--secondary vyre-btn--lg">
          Set up AI context
        </a>
      </div>
    </div>
  </section>

  <!-- ── FOOTER ─────────────────────────────────────────────────── -->
  <footer class="footer">
    <div class="section-inner footer__inner">
      <p class="footer__copy">
        Built by <a href="https://gapra.dev/" target="_blank" rel="noopener noreferrer">Gapra</a>.
        MIT License.
      </p>
      <p class="footer__links">
        <a href="https://github.com/gapra/usevyre" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="/docs/getting-started">Docs</a>
        <a href="/docs/tokens">Tokens</a>
      </p>
    </div>
  </footer>
</BaseLayout>
