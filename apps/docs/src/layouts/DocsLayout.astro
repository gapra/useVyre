---
import BaseLayout        from "./BaseLayout.astro";
import TopNav            from "@/components/layout/TopNav.astro";
import Sidebar           from "@/components/layout/Sidebar.astro";
import TableOfContents   from "@/components/docs/TableOfContents.astro";

export interface Props {
  title:        string;
  description?: string;
  component?:   string;
  /** Hide the right-rail TOC and let content span the full width. */
  wide?:        boolean;
}

const { title, description, component, wide = false } = Astro.props;
const pathname = Astro.url.pathname;
---

<BaseLayout title={title} description={description}>
  <script>
    const SIDEBAR_KEY = "vyre-sidebar-scroll";

    const sidebar = document.querySelector(".docs-sidebar");
    if (sidebar) {
      // On a Components page, bring the (bottom) Components section into view so
      // the user lands on the relevant nav — otherwise the restored scroll
      // position leaves the long list parked at the top. Scroll to the active
      // component if there is one, else to the Components heading. Elsewhere,
      // restore the saved scroll position for continuity.
      const onComponents = location.pathname.startsWith("/docs/components");
      const heading = sidebar.querySelector(".sidebar__heading--link");
      const active = sidebar.querySelector(".sidebar__link--active");
      const target = onComponents ? (active || heading) : null;
      if (target) {
        // Scroll only the sidebar (not the page): center the active item so its
        // neighbours are visible; for the heading, leave a little breathing room
        // at the top instead of pinning it flush against the header.
        const offset = active ? sidebar.clientHeight / 2 : 24;
        sidebar.scrollTop = Math.max(0, target.offsetTop - offset);
      } else {
        const saved = sessionStorage.getItem(SIDEBAR_KEY);
        if (saved) sidebar.scrollTop = Number(saved);
      }
    }

    window.addEventListener("beforeunload", () => {
      const el = document.querySelector(".docs-sidebar");
      if (el) sessionStorage.setItem(SIDEBAR_KEY, String(el.scrollTop));
    });
  </script>
  <div class="docs-root">
    <TopNav currentPath={pathname} />

    <div class:list={["docs-body", { "docs-body--wide": wide }]}>
      <aside class="docs-sidebar">
        <Sidebar currentPath={pathname} />
      </aside>

      <main class="docs-content" id="main-content">
        <article class:list={["docs-article", { "docs-article--wide": wide }]}>
          <slot />
        </article>
      </main>

      {!wide && (
        <aside class="docs-toc">
          <TableOfContents component={component} />
        </aside>
      )}
    </div>
  </div>
</BaseLayout>
