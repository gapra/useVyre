---
export interface Prop {
  name:         string;
  type:         string;
  default?:     string;
  description:  string;
  required?:    boolean;
}

export interface Props {
  props: Prop[];
  title?: string;
}

const { props: rows, title = "Props" } = Astro.props;
---

<div class="props-table-wrapper">
  {title && <h3 class="props-table__title">{title}</h3>}
  <div class="props-table-scroll">
    <table class="props-table">
      <thead>
        <tr>
          <th>Prop</th>
          <th>Type</th>
          <th>Default</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            <td>
              <code class="props-table__name">{row.name}</code>
              {row.required && <span class="props-table__required">*</span>}
            </td>
            <td><code class="props-table__type">{row.type}</code></td>
            <td>
              {row.default
                ? <code class="props-table__default">{row.default}</code>
                : <span class="props-table__empty">—</span>}
            </td>
            <td class="props-table__desc">{row.description}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
