---
import { Code } from "astro:components";

export interface Props {
  react: string;
  vue?: string;
}

const { react, vue } = Astro.props;
const id = `ct-${Math.random().toString(36).slice(2, 7)}`;
---

<div class="cp" id={id}>
  <div class="cp__code" style="border-radius: var(--vyre-border-radius-lg); overflow: hidden;">
    <div class="cp__tabs" role="tablist" aria-label="Code examples">
      <button
        class="cp__tab cp__tab--active"
        role="tab"
        aria-selected="true"
        data-target={`${id}-react`}
        type="button"
      >React</button>
      {vue && (
        <button
          class="cp__tab"
          role="tab"
          aria-selected="false"
          data-target={`${id}-vue`}
          type="button"
        >Vue</button>
      )}
      <button class="cp__copy" data-copy={react} type="button" aria-label="Copy code">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <rect x="4" y="4" width="8" height="8" rx="1" stroke="currentColor" stroke-width="1.3"/>
          <path d="M2 10V2h8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
        </svg>
        <span class="cp__copy-label">Copy</span>
      </button>
    </div>
    <div id={`${id}-react`} class="cp__panel" role="tabpanel">
      <Code code={react} lang="tsx" theme="github-dark" />
    </div>
    {vue && (
      <div id={`${id}-vue`} class="cp__panel" role="tabpanel" hidden>
        <Code code={vue} lang="vue" theme="github-dark" />
      </div>
    )}
  </div>
</div>

<script>
  document.querySelectorAll(".cp").forEach((cp) => {
    const tabs     = cp.querySelectorAll<HTMLButtonElement>(".cp__tab");
    const panels   = cp.querySelectorAll<HTMLElement>(".cp__panel");
    const copyBtn  = cp.querySelector<HTMLButtonElement>(".cp__copy");
    const copyLabel = copyBtn?.querySelector<HTMLElement>(".cp__copy-label");

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        tabs.forEach((t) => {
          t.classList.remove("cp__tab--active");
          t.setAttribute("aria-selected", "false");
        });
        panels.forEach((p) => { p.hidden = true; });
        tab.classList.add("cp__tab--active");
        tab.setAttribute("aria-selected", "true");
        const panel = document.getElementById(tab.dataset.target!);
        if (panel) panel.hidden = false;
      });
    });

    copyBtn?.addEventListener("click", async () => {
      const activeTab = cp.querySelector<HTMLButtonElement>(".cp__tab--active");
      const panelId   = activeTab?.dataset.target;
      const panelEl   = panelId ? document.getElementById(panelId) : null;
      const code      = panelEl?.querySelector("code")?.textContent ?? copyBtn?.dataset.copy ?? "";
      await navigator.clipboard.writeText(code);
      if (copyLabel) {
        copyLabel.textContent = "Copied!";
        setTimeout(() => { copyLabel.textContent = "Copy"; }, 2000);
      }
    });
  });
</script>
