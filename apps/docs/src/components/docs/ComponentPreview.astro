---
import { Code } from "astro:components";

export interface Props {
  /** React code snippet to display */
  react:     string;
  /** Vue code snippet to display */
  vue?:      string;
  /** Title shown above the preview */
  title?:    string;
  /** Adjust preview background */
  bg?:       "default" | "grid" | "transparent";
  /** Extra wrapper class for the preview pane */
  class?:    string;
}

const { react, vue, title, bg = "default", class: extraClass } = Astro.props;
const id = `preview-${Math.random().toString(36).slice(2, 7)}`;
---

<div class="cp" id={id}>
  {title && <p class="cp__title">{title}</p>}

  <!-- Live preview pane -->
  <div class:list={["cp__preview", `cp__preview--${bg}`, extraClass]}>
    <slot />
  </div>

  <!-- Code pane -->
  <div class="cp__code">
    <!-- Tab bar -->
    <div class="cp__tabs" role="tablist" aria-label="Code examples">
      <button
        class="cp__tab cp__tab--active"
        role="tab"
        aria-selected="true"
        data-target={`${id}-react`}
        type="button"
      >React</button>
      {vue && (
        <button
          class="cp__tab"
          role="tab"
          aria-selected="false"
          data-target={`${id}-vue`}
          type="button"
        >Vue</button>
      )}
      <button class="cp__copy" data-copy={react} type="button" aria-label="Copy code">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <rect x="4" y="4" width="8" height="8" rx="1" stroke="currentColor" stroke-width="1.3"/>
          <path d="M2 10V2h8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
        </svg>
        <span class="cp__copy-label">Copy</span>
      </button>
    </div>

    <!-- Code panels -->
    <div id={`${id}-react`} class="cp__panel" role="tabpanel">
      <Code code={react} lang="tsx" theme="github-dark" />
    </div>
    {vue && (
      <div id={`${id}-vue`} class="cp__panel" role="tabpanel" hidden>
        <Code code={vue} lang="vue" theme="github-dark" />
      </div>
    )}
  </div>
</div>

<script>
  // Tab switching + copy — runs once per island
  document.querySelectorAll(".cp").forEach((cp) => {
    const tabs  = cp.querySelectorAll<HTMLButtonElement>(".cp__tab");
    const panels = cp.querySelectorAll<HTMLElement>(".cp__panel");
    const copyBtn = cp.querySelector<HTMLButtonElement>(".cp__copy");
    const copyLabel = copyBtn?.querySelector<HTMLElement>(".cp__copy-label");

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const target = tab.dataset.target;
        tabs.forEach((t) => {
          t.classList.remove("cp__tab--active");
          t.setAttribute("aria-selected", "false");
        });
        panels.forEach((p) => { p.hidden = true; });
        tab.classList.add("cp__tab--active");
        tab.setAttribute("aria-selected", "true");
        const panel = document.getElementById(target!);
        if (panel) panel.hidden = false;
        // update copy source
        if (copyBtn) copyBtn.dataset.copy = tab.dataset.target?.includes("vue")
          ? (cp.querySelector("[data-vue]") as HTMLElement)?.dataset.vue ?? ""
          : copyBtn.dataset.copy;
      });
    });

    copyBtn?.addEventListener("click", async () => {
      const code = copyBtn.dataset.copy ?? "";
      await navigator.clipboard.writeText(code);
      if (copyLabel) {
        copyLabel.textContent = "Copied!";
        setTimeout(() => { copyLabel.textContent = "Copy"; }, 2000);
      }
    });
  });
</script>
