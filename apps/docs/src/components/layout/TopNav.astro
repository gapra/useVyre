---
import Sidebar from "@/components/layout/Sidebar.astro";

export interface Props {
  /** When set, the mobile drawer also renders the docs sidebar for this path. */
  currentPath?: string;
}

const { currentPath } = Astro.props;

const links = [
  { label: "Docs",       href: "/docs/getting-started" },
  { label: "AI Context",       href: "/docs/ai-context" },
  { label: "Components", href: "/docs/components" },
  { label: "Tokens",     href: "/docs/tokens" },
  { label: "MCP Server", href: "/docs/ai-tooling/mcp-server" },
  //{ label: "GitHub",     href: "https://github.com/gapra/usevyre", external: true },
];
---

<header class="topnav">
  <div class="topnav__inner">
    <!-- Logo -->
    <a href="/" class="topnav__logo" aria-label="useVyre home">
      <svg class="topnav__logo-mark" width="20" height="16" viewBox="0 0 28 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <defs>
          <linearGradient id="logo-g" x1="0" y1="0" x2="28" y2="20" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#a78bfa"/>
            <stop offset="100%" stop-color="#7c3aed"/>
          </linearGradient>
        </defs>
        <path d="M10 0 L17 7 L10 14 L3 7 Z" fill="url(#logo-g)"/>
        <path d="M18 0 L25 7 L18 14 L11 7 Z" fill="none" stroke="url(#logo-g)" stroke-width="1.75" stroke-linejoin="round"/>
      </svg>
      <span class="topnav__logo-text">useVyre</span>
      <span class="topnav__version vyre-badge vyre-badge--default">AI-ready</span>
    </a>

    <!-- Nav links -->
    <nav class="topnav__links" aria-label="Main navigation">
      {links.map((link) => (
        <a
          href={link.href}
          class="topnav__link"
          target={link.external ? "_blank" : undefined}
          rel={link.external ? "noopener noreferrer" : undefined}
        >
          {link.label}
          {link.external && (
            <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
              <path d="M2 8L8 2M8 2H4M8 2V6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          )}
        </a>
      ))}
    </nav>

    <!-- Right actions -->
    <div class="topnav__actions">
      <!-- Mobile menu toggle -->
      <button
        id="mobile-nav-toggle"
        class="topnav__icon-btn topnav__menu-btn"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-drawer"
        type="button"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>

      <!-- Theme toggle -->
      <button
        id="theme-toggle"
        class="topnav__icon-btn"
        aria-label="Toggle color theme"
        title="Toggle light/dark mode"
        type="button"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg class="theme-icon theme-icon--sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg class="theme-icon theme-icon--moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <a
        href="https://github.com/gapra/usevyre"
        class="topnav__icon-btn"
        aria-label="GitHub"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483
            0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608
            1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338
            -2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65
            0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337
            1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688
            0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747
            0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
      </a>
    </div>
  </div>
</header>

<!-- Mobile navigation drawer -->
<div id="mobile-nav-overlay" class="mobile-nav-overlay" hidden></div>
<aside
  id="mobile-drawer"
  class="mobile-drawer"
  aria-label="Mobile navigation"
  aria-hidden="true"
  hidden
>
  <div class="mobile-drawer__head">
    <span class="mobile-drawer__title">Menu</span>
    <button id="mobile-nav-close" class="topnav__icon-btn" aria-label="Close menu" type="button">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <nav class="mobile-drawer__links" aria-label="Primary">
    {links.map((link) => (
      <a
        href={link.href}
        class="mobile-drawer__link"
        target={link.external ? "_blank" : undefined}
        rel={link.external ? "noopener noreferrer" : undefined}
      >
        {link.label}
      </a>
    ))}
  </nav>

  {currentPath && (
    <div class="mobile-drawer__sidebar">
      <Sidebar currentPath={currentPath} />
    </div>
  )}
</aside>

<style>
  /* Show correct icon based on current theme */
  :root:not([data-theme="dark"]) .theme-icon--sun,
  [data-theme="light"] .theme-icon--sun {
    display: none;
  }
  [data-theme="dark"] .theme-icon--moon {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) .theme-icon--moon {
      display: none;
    }
    :root:not([data-theme]) .theme-icon--sun {
      display: block;
    }
  }
</style>

<script>
  const toggle = document.getElementById("theme-toggle");
  if (toggle) {
    toggle.addEventListener("click", () => {
      const html = document.documentElement;
      const current = html.getAttribute("data-theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      // Resolve effective current theme
      const effectiveDark = current === "dark" || (!current && prefersDark);
      const next = effectiveDark ? "light" : "dark";
      html.setAttribute("data-theme", next);
      try { localStorage.setItem("vyre-theme", next); } catch {}
    });
  }

  // ── Mobile navigation drawer ──────────────────────────────────
  const drawer  = document.getElementById("mobile-drawer");
  const overlay = document.getElementById("mobile-nav-overlay");
  const openBtn = document.getElementById("mobile-nav-toggle");
  const closeBtn = document.getElementById("mobile-nav-close");

  if (drawer && overlay && openBtn) {
    const openDrawer = () => {
      drawer.hidden = false;
      overlay.hidden = false;
      // Next frame so the transition runs from the hidden state.
      requestAnimationFrame(() => {
        drawer.classList.add("is-open");
        overlay.classList.add("is-open");
      });
      drawer.setAttribute("aria-hidden", "false");
      openBtn.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
    };

    const closeDrawer = () => {
      drawer.classList.remove("is-open");
      overlay.classList.remove("is-open");
      drawer.setAttribute("aria-hidden", "true");
      openBtn.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
      // Hide after the slide-out transition so it can't be tab-focused.
      const onEnd = () => {
        drawer.hidden = true;
        overlay.hidden = true;
        drawer.removeEventListener("transitionend", onEnd);
      };
      drawer.addEventListener("transitionend", onEnd);
    };

    openBtn.addEventListener("click", openDrawer);
    closeBtn?.addEventListener("click", closeDrawer);
    overlay.addEventListener("click", closeDrawer);

    // Close when any link inside the drawer is tapped.
    drawer.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", closeDrawer)
    );

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !drawer.hidden) closeDrawer();
    });

    // Reset if the viewport grows past the mobile breakpoint while open.
    window.matchMedia("(min-width: 769px)").addEventListener("change", (e) => {
      if (e.matches && !drawer.hidden) closeDrawer();
    });
  }
</script>
