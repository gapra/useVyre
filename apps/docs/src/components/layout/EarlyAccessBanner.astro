---
const FEEDBACK_URL = "https://github.com/gapra/usevyre/issues/new?labels=feedback&template=feedback.md&title=%5BFeedback%5D+";
---

<div class="eab" id="early-access-banner" role="banner" aria-label="Early access notice">
  <div class="eab__inner">
    <span class="eab__badge">Early Access</span>
    <p class="eab__text">
      useVyre is under active development - things may change.
      <a href={FEEDBACK_URL} class="eab__link" target="_blank" rel="noopener noreferrer">
        Share feedback or ideas →
      </a>
    </p>
    <button class="eab__close" id="eab-close" aria-label="Dismiss banner" type="button">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>
</div>

<script>
  const STORAGE_KEY = "vyre-eab-dismissed";
  const banner = document.getElementById("early-access-banner");
  const closeBtn = document.getElementById("eab-close");

  // Hide immediately if already dismissed
  if (banner) {
    try {
      if (localStorage.getItem(STORAGE_KEY) === "1") {
        banner.style.display = "none";
      }
    } catch (_) {}
  }

  closeBtn?.addEventListener("click", () => {
    if (banner) {
      banner.style.maxHeight = banner.scrollHeight + "px";
      requestAnimationFrame(() => {
        banner.classList.add("eab--dismissing");
      });
      banner.addEventListener("transitionend", () => {
        banner.style.display = "none";
      }, { once: true });
    }
    try { localStorage.setItem(STORAGE_KEY, "1"); } catch (_) {}
  });
</script>
