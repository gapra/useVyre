{
  "$schema": "https://tr.designtokens.org/format/",
  "$metadata": {
    "name": "useVyre Design Tokens",
    "version": "0.2.0",
    "description": "AI-native design tokens. All tokens follow --vyre-[category]-[variant]-[property] naming.",
    "ai-context": "These tokens are the single source of truth for all useVyre visual decisions. When building UI with useVyre, always reference token names rather than raw values. Semantic tokens adapt automatically to light/dark themes."
  },

  "color": {
    "$type": "color",

    "primitive": {
      "$description": "Raw color palette. Do NOT use directly in components — use semantic tokens instead.",
      "neutral": {
        "0":   { "$value": "#ffffff" },
        "50":  { "$value": "#fafafa" },
        "100": { "$value": "#f4f4f5" },
        "150": { "$value": "#ebebec" },
        "200": { "$value": "#e4e4e7" },
        "300": { "$value": "#d1d1d6" },
        "400": { "$value": "#a1a1aa" },
        "500": { "$value": "#71717a" },
        "600": { "$value": "#52525b" },
        "700": { "$value": "#3f3f46" },
        "750": { "$value": "#333338" },
        "800": { "$value": "#27272a" },
        "850": { "$value": "#1e1e21" },
        "900": { "$value": "#18181b" },
        "950": { "$value": "#09090b" }
      },
      "violet": {
        "50":  { "$value": "#f5f3ff" },
        "100": { "$value": "#ede9fe" },
        "200": { "$value": "#ddd6fe" },
        "300": { "$value": "#c4b5fd" },
        "400": { "$value": "#a78bfa" },
        "500": { "$value": "#8b5cf6" },
        "600": { "$value": "#7c3aed" },
        "700": { "$value": "#6d28d9" }
      },
      "blue": {
        "50":  { "$value": "#eff6ff" },
        "100": { "$value": "#dbeafe" },
        "400": { "$value": "#60a5fa" },
        "500": { "$value": "#3b82f6" },
        "600": { "$value": "#2563eb" },
        "700": { "$value": "#1d4ed8" }
      },
      "teal": {
        "300": { "$value": "#5eead4" },
        "400": { "$value": "#2dd4bf" },
        "500": { "$value": "#14b8a6" },
        "600": { "$value": "#0d9488" }
      },
      "red": {
        "50":  { "$value": "#fef2f2" },
        "100": { "$value": "#fee2e2" },
        "400": { "$value": "#f87171" },
        "500": { "$value": "#ef4444" },
        "600": { "$value": "#dc2626" }
      },
      "green": {
        "50":  { "$value": "#f0fdf4" },
        "100": { "$value": "#dcfce7" },
        "400": { "$value": "#4ade80" },
        "500": { "$value": "#22c55e" },
        "600": { "$value": "#16a34a" }
      },
      "amber": {
        "50":  { "$value": "#fffbeb" },
        "100": { "$value": "#fef3c7" },
        "300": { "$value": "#fcd34d" },
        "400": { "$value": "#fbbf24" },
        "500": { "$value": "#f59e0b" },
        "600": { "$value": "#d97706" }
      }
    },

    "semantic-light": {
      "$description": "Light theme semantic tokens. Applied at :root by default.",

      "background":       { "$value": "{color.primitive.neutral.0}",   "$description": "Page/app background. Deepest layer." },
      "surface":          { "$value": "{color.primitive.neutral.50}",  "$description": "Cards, panels, sidebars." },
      "surface-raised":   { "$value": "{color.primitive.neutral.100}", "$description": "Dropdowns, popovers, elevated cards." },
      "surface-overlay":  { "$value": "{color.primitive.neutral.0}",   "$description": "Modals, tooltips, highest elevation." },

      "border":           { "$value": "{color.primitive.neutral.200}", "$description": "Default border for cards, inputs, dividers." },
      "border-subtle":    { "$value": "{color.primitive.neutral.150}", "$description": "Very low contrast border. Section dividers." },
      "border-strong":    { "$value": "{color.primitive.neutral.400}", "$description": "Focused inputs, selected states." },

      "text-primary":     { "$value": "{color.primitive.neutral.950}", "$description": "Headings, body text, primary content." },
      "text-secondary":   { "$value": "{color.primitive.neutral.600}", "$description": "Subtitles, descriptions, supporting text." },
      "text-muted":       { "$value": "{color.primitive.neutral.400}", "$description": "Placeholders, timestamps, helper text." },
      "text-disabled":    { "$value": "{color.primitive.neutral.300}", "$description": "Disabled state text." },
      "text-inverse":     { "$value": "{color.primitive.neutral.0}",   "$description": "Text on dark/accent backgrounds." },

      "accent":           { "$value": "{color.primitive.violet.600}",  "$description": "Primary brand accent. CTAs, highlights, focus rings." },
      "accent-hover":     { "$value": "{color.primitive.violet.700}",  "$description": "Hover state for accent elements." },
      "accent-foreground":{ "$value": "{color.primitive.neutral.0}",   "$description": "Text color on accent background." },
      "accent-subtle":    { "$value": "{color.primitive.violet.50}",   "$description": "Low-opacity accent for badge backgrounds, highlights." },
      "accent-subtle-border": { "$value": "{color.primitive.violet.200}", "$description": "Border for accent subtle containers." },

      "teal":             { "$value": "{color.primitive.teal.500}",    "$description": "Secondary accent. Code, AI-context indicators." },
      "teal-hover":       { "$value": "{color.primitive.teal.600}",    "$description": "Hover state for teal elements." },
      "teal-subtle":      { "$value": "rgba(20, 184, 166, 0.08)",      "$description": "Low-opacity teal for badge backgrounds." },

      "success":          { "$value": "{color.primitive.green.600}",   "$description": "Success states, confirmations." },
      "success-subtle":   { "$value": "{color.primitive.green.50}",    "$description": "Success badge background." },
      "success-subtle-border": { "$value": "{color.primitive.green.100}", "$description": "Border for success subtle containers." },

      "warning":          { "$value": "{color.primitive.amber.500}",   "$description": "Warning states, beta indicators." },
      "warning-subtle":   { "$value": "{color.primitive.amber.50}",    "$description": "Warning badge background." },
      "warning-subtle-border": { "$value": "{color.primitive.amber.100}", "$description": "Border for warning subtle containers." },

      "danger":           { "$value": "{color.primitive.red.600}",     "$description": "Error states, destructive actions." },
      "danger-hover":     { "$value": "{color.primitive.red.500}",     "$description": "Hover state for danger elements." },
      "danger-subtle":    { "$value": "{color.primitive.red.50}",      "$description": "Error badge background." },
      "danger-subtle-border": { "$value": "{color.primitive.red.100}", "$description": "Border for danger subtle containers." }
    },

    "semantic-dark": {
      "$description": "Dark theme semantic tokens. Applied under [data-theme='dark'].",

      "background":       { "$value": "{color.primitive.neutral.950}", "$description": "Page/app background. Deepest layer." },
      "surface":          { "$value": "{color.primitive.neutral.900}", "$description": "Cards, panels, sidebars." },
      "surface-raised":   { "$value": "{color.primitive.neutral.800}", "$description": "Dropdowns, popovers, elevated cards." },
      "surface-overlay":  { "$value": "{color.primitive.neutral.750}", "$description": "Modals, tooltips, highest elevation." },

      "border":           { "$value": "{color.primitive.neutral.700}", "$description": "Default border for cards, inputs, dividers." },
      "border-subtle":    { "$value": "{color.primitive.neutral.800}", "$description": "Very low contrast border. Section dividers." },
      "border-strong":    { "$value": "{color.primitive.neutral.500}", "$description": "Focused inputs, selected states." },

      "text-primary":     { "$value": "{color.primitive.neutral.50}",  "$description": "Headings, body text, primary content." },
      "text-secondary":   { "$value": "{color.primitive.neutral.300}", "$description": "Subtitles, descriptions, supporting text." },
      "text-muted":       { "$value": "{color.primitive.neutral.500}", "$description": "Placeholders, timestamps, helper text." },
      "text-disabled":    { "$value": "{color.primitive.neutral.600}", "$description": "Disabled state text." },
      "text-inverse":     { "$value": "{color.primitive.neutral.950}", "$description": "Text on light/accent backgrounds." },

      "accent":           { "$value": "{color.primitive.violet.400}",  "$description": "Primary brand accent. CTAs, highlights, focus rings." },
      "accent-hover":     { "$value": "{color.primitive.violet.300}",  "$description": "Hover state for accent elements." },
      "accent-foreground":{ "$value": "{color.primitive.neutral.950}", "$description": "Text color on accent background." },
      "accent-subtle":    { "$value": "rgba(139, 92, 246, 0.12)",      "$description": "Low-opacity accent for badge backgrounds, highlights." },
      "accent-subtle-border": { "$value": "rgba(139, 92, 246, 0.25)", "$description": "Border for accent subtle containers." },

      "teal":             { "$value": "{color.primitive.teal.400}",    "$description": "Secondary accent. Code, AI-context indicators." },
      "teal-hover":       { "$value": "{color.primitive.teal.300}",    "$description": "Hover state for teal elements." },
      "teal-subtle":      { "$value": "rgba(45, 212, 191, 0.10)",      "$description": "Low-opacity teal for badge backgrounds." },

      "success":          { "$value": "{color.primitive.green.400}",   "$description": "Success states, confirmations." },
      "success-subtle":   { "$value": "rgba(74, 222, 128, 0.10)",      "$description": "Success badge background." },
      "success-subtle-border": { "$value": "rgba(74, 222, 128, 0.20)", "$description": "Border for success subtle containers." },

      "warning":          { "$value": "{color.primitive.amber.400}",   "$description": "Warning states, beta indicators." },
      "warning-subtle":   { "$value": "rgba(251, 191, 36, 0.10)",      "$description": "Warning badge background." },
      "warning-subtle-border": { "$value": "rgba(251, 191, 36, 0.20)", "$description": "Border for warning subtle containers." },

      "danger":           { "$value": "{color.primitive.red.400}",     "$description": "Error states, destructive actions." },
      "danger-hover":     { "$value": "{color.primitive.red.500}",     "$description": "Hover state for danger elements (lighter in dark theme)." },
      "danger-subtle":    { "$value": "rgba(248, 113, 113, 0.10)",     "$description": "Error badge background." },
      "danger-subtle-border": { "$value": "rgba(248, 113, 113, 0.20)", "$description": "Border for danger subtle containers." }
    }
  },

  "typography": {
    "$description": "Font families, sizes, weights, and line heights.",

    "font-family": {
      "display": {
        "$value": "'Geist', 'Inter', system-ui, sans-serif",
        "$type": "fontFamily",
        "$description": "Headlines, hero text, display type."
      },
      "body": {
        "$value": "'Geist', 'Inter', system-ui, sans-serif",
        "$type": "fontFamily",
        "$description": "Body copy, UI labels, all general text."
      },
      "mono": {
        "$value": "'Geist Mono', 'JetBrains Mono', monospace",
        "$type": "fontFamily",
        "$description": "Code, tokens, technical labels, AI hints."
      }
    },

    "font-size": {
      "2xs": { "$value": "0.625rem",  "$type": "dimension", "$description": "10px. Tiny labels only." },
      "xs":  { "$value": "0.6875rem", "$type": "dimension", "$description": "11px. Badge text, captions." },
      "sm":  { "$value": "0.8125rem", "$type": "dimension", "$description": "13px. Default UI text, buttons." },
      "md":  { "$value": "0.9375rem", "$type": "dimension", "$description": "15px. Body text." },
      "lg":  { "$value": "1.125rem",  "$type": "dimension", "$description": "18px. Large body, small headings." },
      "xl":  { "$value": "1.375rem",  "$type": "dimension", "$description": "22px. Section headings." },
      "2xl": { "$value": "1.75rem",   "$type": "dimension", "$description": "28px. Page headings." },
      "3xl": { "$value": "2.25rem",   "$type": "dimension", "$description": "36px. Large headings." },
      "4xl": { "$value": "3rem",      "$type": "dimension", "$description": "48px. Hero headings." },
      "5xl": { "$value": "4rem",      "$type": "dimension", "$description": "64px. Display headings." }
    },

    "font-weight": {
      "light":    { "$value": 300, "$type": "fontWeight" },
      "regular":  { "$value": 400, "$type": "fontWeight" },
      "medium":   { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold":     { "$value": 700, "$type": "fontWeight" }
    },

    "line-height": {
      "none":    { "$value": 1,    "$type": "number" },
      "tight":   { "$value": 1.2,  "$type": "number" },
      "snug":    { "$value": 1.35, "$type": "number" },
      "normal":  { "$value": 1.5,  "$type": "number" },
      "relaxed": { "$value": 1.7,  "$type": "number" }
    }
  },

  "spacing": {
    "$description": "4px base grid. Use these for padding, margin, gap.",
    "$type": "dimension",
    "0":  { "$value": "0" },
    "1":  { "$value": "0.25rem",  "$description": "4px" },
    "2":  { "$value": "0.5rem",   "$description": "8px" },
    "3":  { "$value": "0.75rem",  "$description": "12px" },
    "4":  { "$value": "1rem",     "$description": "16px" },
    "5":  { "$value": "1.25rem",  "$description": "20px" },
    "6":  { "$value": "1.5rem",   "$description": "24px" },
    "8":  { "$value": "2rem",     "$description": "32px" },
    "10": { "$value": "2.5rem",   "$description": "40px" },
    "12": { "$value": "3rem",     "$description": "48px" },
    "16": { "$value": "4rem",     "$description": "64px" },
    "20": { "$value": "5rem",     "$description": "80px" },
    "24": { "$value": "6rem",     "$description": "96px" }
  },

  "border-radius": {
    "$type": "dimension",
    "none": { "$value": "0" },
    "sm":   { "$value": "0.375rem", "$description": "6px. Tight corners." },
    "md":   { "$value": "0.5rem",   "$description": "8px. Default component radius." },
    "lg":   { "$value": "0.75rem",  "$description": "12px. Cards, panels." },
    "xl":   { "$value": "1rem",     "$description": "16px. Large cards." },
    "2xl":  { "$value": "1.5rem",   "$description": "24px. Modals, sheets." },
    "full": { "$value": "9999px",   "$description": "Badges, pills, avatars." }
  },

  "shadow": {
    "$description": "Elevation shadows. Light theme uses soft shadows; dark theme uses deeper shadows.",
    "sm":  { "$value": "0 1px 2px rgba(0,0,0,0.06), 0 1px 1px rgba(0,0,0,0.04)", "$type": "shadow" },
    "md":  { "$value": "0 4px 6px rgba(0,0,0,0.07), 0 2px 4px rgba(0,0,0,0.06)", "$type": "shadow" },
    "lg":  { "$value": "0 10px 15px rgba(0,0,0,0.08), 0 4px 6px rgba(0,0,0,0.05)", "$type": "shadow" },
    "xl":  { "$value": "0 20px 25px rgba(0,0,0,0.10), 0 8px 10px rgba(0,0,0,0.06)", "$type": "shadow" },
    "sm-dark":  { "$value": "0 1px 2px rgba(0,0,0,0.4)", "$type": "shadow" },
    "md-dark":  { "$value": "0 4px 12px rgba(0,0,0,0.4), 0 1px 3px rgba(0,0,0,0.3)", "$type": "shadow" },
    "lg-dark":  { "$value": "0 12px 32px rgba(0,0,0,0.5), 0 4px 8px rgba(0,0,0,0.3)", "$type": "shadow" },
    "xl-dark":  { "$value": "0 24px 64px rgba(0,0,0,0.6), 0 8px 16px rgba(0,0,0,0.3)", "$type": "shadow" },
    "glow-accent": { "$value": "0 0 0 3px rgba(124, 58, 237, 0.15)", "$type": "shadow" },
    "glow-teal":   { "$value": "0 0 0 3px rgba(20, 184, 166, 0.15)", "$type": "shadow" }
  },

  "transition": {
    "duration": {
      "instant": { "$value": "80ms",  "$type": "duration" },
      "fast":    { "$value": "120ms", "$type": "duration" },
      "normal":  { "$value": "200ms", "$type": "duration" },
      "slow":    { "$value": "350ms", "$type": "duration" }
    },
    "easing": {
      "out":    { "$value": "cubic-bezier(0.0, 0, 0.2, 1)",      "$type": "cubicBezier" },
      "in":     { "$value": "cubic-bezier(0.4, 0, 1, 1)",        "$type": "cubicBezier" },
      "inout":  { "$value": "cubic-bezier(0.4, 0, 0.2, 1)",      "$type": "cubicBezier" },
      "spring": { "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)", "$type": "cubicBezier" }
    }
  },

  "z-index": {
    "$description": "Z-index scale for stacking contexts.",
    "base":    { "$value": 0 },
    "raised":  { "$value": 10 },
    "sticky":  { "$value": 100 },
    "overlay": { "$value": 200 },
    "modal":   { "$value": 1000 },
    "toast":   { "$value": 2000 }
  }
}
