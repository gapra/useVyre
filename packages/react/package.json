{
  "name": "@usevyre/react",
  "version": "1.2.1",
  "description": "useVyre React components — AI-native, accessible, zero-runtime styling",
  "keywords": [
    "design-system",
    "react",
    "components",
    "ai-native",
    "vyre"
  ],
  "homepage": "https://usevyre.com/docs/getting-started",
  "repository": {
    "type": "git",
    "url": "https://github.com/gapra/usevyre"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./styles": "./dist/styles/components.css"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --project tsconfig.build.json && mkdir -p dist/styles && cp src/styles/components.css dist/styles/",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@usevyre/tokens": "^1.0.0"
  }
}
