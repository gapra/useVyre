{
  "name": "usevyre",
  "private": true,
  "description": "useVyre — AI-native design system for humans and agents",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "dev:docs": "pnpm --filter @usevyre/tokens build && pnpm --filter @usevyre/docs dev",
    "build:docs": "pnpm --filter @usevyre/tokens build && pnpm --filter @usevyre/docs build",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "node eval/report.js",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/vue": "^8",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/ui": "^3.2.6",
    "@vue/test-utils": "^2",
    "jsdom": "^29.1.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.6",
    "vue": "3.5.33"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "hono@>=4.0.0 <4.12.34": "^4.12.34",
      "qs@>=6.0.0 <6.15.2": "6.15.2",
      "@babel/core@>=7.0.0 <7.29.6": "^7.29.6",
      "brace-expansion@>=5.0.0 <5.0.9": "^5.0.9",
      "brace-expansion@>=2.0.0 <2.1.2": "^2.1.2",
      "vite@>=5.0.0 <6.4.3": "6.4.3",
      "undici@>=7.0.0 <7.29.0": "^7.29.0",
      "ip-address@<10.3.1": "^10.3.1",
      "fast-uri@>=3.0.0 <3.1.5": "^3.1.5",
      "postcss@<8.5.23": "^8.5.23",
      "js-yaml@>=4.0.0 <4.3.0": "^4.3.0",
      "js-yaml@>=3.0.0 <3.15.0": "^3.15.0",
      "body-parser@>=2.0.0 <2.3.0": "^2.3.0",
      "@hono/node-server@<2.0.5": "^2.0.5"
    }
  }
}
