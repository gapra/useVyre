{
  "name": "usevyre",
  "private": true,
  "description": "useVyre — AI-native design system for humans and agents",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "dev:docs": "pnpm --filter @usevyre/tokens build && pnpm --filter @usevyre/docs dev",
    "build:docs": "pnpm --filter @usevyre/tokens build && pnpm --filter @usevyre/docs build",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "node eval/report.js",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/vue": "^8",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/ui": "^3",
    "@vue/test-utils": "^2",
    "jsdom": "^29.1.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.4.0",
    "vitest": "^3",
    "vue": "3.5.33"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
